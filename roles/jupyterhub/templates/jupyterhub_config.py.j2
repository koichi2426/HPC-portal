                    <div><label class="label">Hours</label><input type="number" class="form-control input-dark" name="hours" value="8" min="1"></div>
                </div>
                <div style="font-size:0.74rem;color:#777;margin-top:-5px;">Open WebUIで大型LLMを使う場合は GPUs を 1 以上にしてください。</div>
            </div>
        </div>
    </div>
    """

    js_code = """
    <script>
    document.addEventListener("DOMContentLoaded", function() {
        function format1(value) {
            return Number(value || 0).toFixed(1);
        }
        function applyResourceSnapshot(data) {
            const text = {
                cpu_status: data.cpu_status,
                cpu_available_count: `残り ${format1(data.cpu_available_count)} vCPU`,
                cpu_total: `最大 ${data.cpu_total || 0} vCPU`,
                mem_status: data.mem_status,
                mem_available_gb: `残り ${format1(data.mem_available_gb)} GB`,
                mem_total_gb: `最大 ${format1(data.mem_total_gb)} GB`,
                disk_status: data.disk_status,
                disk_available_gb: `残り ${format1(data.disk_available_gb)} GB`,
                disk_total_gb: `最大 ${format1(data.disk_total_gb)} GB`,
                gpu_status: data.gpu_status,
                gpu_available_count: `空き ${data.gpu_available_count || 0}/${data.gpu_max || 0} GPU`,
                gpu_vram_available_gb: `VRAM ${format1(data.gpu_vram_available_gb)}/${format1(data.gpu_vram_total_gb)} GB`,
            };
            document.querySelectorAll("[data-resource-text]").forEach((el) => {
                const key = el.getAttribute("data-resource-text");
                if (text[key] !== undefined) el.textContent = text[key];
            });
            document.querySelectorAll("[data-resource-width]").forEach((el) => {
                const key = el.getAttribute("data-resource-width");
                const pct = Math.max(0, Math.min(100, Number(data[key] || 0)));
                el.style.width = `${pct.toFixed(0)}%`;
            });
            document.querySelectorAll("[data-resource-updated-at]").forEach((el) => {
                el.textContent = `最終更新 ${new Date().toLocaleTimeString()}`;
            });
        }
        function refreshResourceSnapshot() {
            fetch("/hub/hpc-resource-status", {credentials: "same-origin", cache: "no-store"})
                .then((r) => r.ok ? r.json() : Promise.reject())
                .then(applyResourceSnapshot)
                .catch(() => {});
        }
        refreshResourceSnapshot();
        setInterval(refreshResourceSnapshot, 5000);
        const form = document.querySelector('form');
        const appChoice = document.querySelector('select[name="app_choice"]');
        const gpuInput = document.querySelector('input[name="gpu"]');
        if (appChoice && gpuInput) {
            appChoice.addEventListener("change", function() {
                const gpuMax = parseInt(gpuInput.max || "0", 10);
                const gpuCurrent = parseInt(gpuInput.value || "0", 10);
                if (appChoice.value === "open-webui" && gpuMax > 0 && gpuCurrent === 0) {
                    gpuInput.value = "1";
                }
            });
        }
        if (form) {
            form.onsubmit = function() {
                const inputs = document.querySelectorAll('input[name="_xsrf"]');
                if (inputs.length > 1) {
                    for (let i = 1; i < inputs.length; i++) inputs[i].remove();
                }
            };
        }
    });
    </script>
    """
    return header_html + js_code


# 3. データの受け取り
def options_from_form(formdata):
    h = formdata.get("hours", ["8"])[0]
    gpu_max = {{ slurm_effective_gpu_count | default(slurm_gpu_count | default(0)) | int }}
    try:
        g = int(formdata.get("gpu", ["0"])[0] or 0)
    except ValueError:
        g = 0
    g = max(0, min(gpu_max, g))
    return {
        "nprocs": str(formdata.get("cpu", ["2"])[0]),
        "memory": f"{formdata.get('mem', ['4'])[0]}G",
        "runtime": f"{int(h):02d}:00:00",
        "gres_line": f"#SBATCH --gres=gpu:{g}" if g > 0 else "",
        "gpu": str(g),
        "app_choice": str(formdata.get("app_choice", ["ubuntu-cli"])[0]),
    }


def apply_user_options(spawner, user_options):
    spawner.req_nprocs = str(user_options.get("nprocs", "2"))
    spawner.req_memory = str(user_options.get("memory", "4G"))
    spawner.req_runtime = str(user_options.get("runtime", "08:00:00"))
    spawner.user_options["gpu"] = str(user_options.get("gpu", "0"))
    app_choice = str(user_options.get("app_choice", "ubuntu-cli"))
    spawner.user_options["app_choice"] = app_choice
    if app_choice == "open-webui":
        # BatchSpawner の service_url が :0 になると pending から進めないため、
        # server_name ベースで Hub 側ポートを事前確定する
        seed = str(getattr(spawner, "name", "") or "")
        h = sum(ord(c) for c in seed) % 20000
        spawner.port = 20000 + h


# 4. Spawner / Hub クラス紐付け
c.JupyterHub.proxy_class = HpcConfigurableHTTPProxy
c.JupyterHub.spawner_class = HPCSlurmSpawner
c.HPCSlurmSpawner.options_form = make_options_form
c.HPCSlurmSpawner.options_from_form = options_from_form
# batchspawner はジョブ RUNNING 後に self.ip = state_gethost() で上書きする（c.Spawner.ip は最終的に使われない）。
# Slurm が返す短いノード名（例: gx10-ac12）を CHP の target にすると、Node からの外向き HTTP が
# 名前解決・ヘアピン等で失敗し Cloudflare 経由で 502 になることがある。
# Hub・CHP・ジョブが同一ホスト（group_vars の localhost 運用）では 127.0.0.1 に固定する。
# 計算ノードが分かれる場合は FQDN や MultiSlurmSpawner.daemon_resolver 等に切り替えること。
c.HPCSlurmSpawner.state_exechost_exp = "{{ jupyterhub_batch_exechost_exp | default('127.0.0.1') }}"
c.HPCSlurmSpawner.ip = "127.0.0.1"
c.HPCSlurmSpawner.req_nprocs = "2"
c.HPCSlurmSpawner.req_memory = "4G"
c.HPCSlurmSpawner.req_runtime = "08:00:00"
c.HPCSlurmSpawner.req_partition = "debug"
c.Spawner.start_timeout = 300
c.Spawner.cmd = ["jupyterhub-singleuser"]
c.Spawner.apply_user_options = apply_user_options

# 5. 起動スクリプト (Apptainer版・多重エスケープ回避)
# 文字列結合で波括弧を生成して、テンプレート干渉を防ぐ
js = "{" + "{"
je = "}" + "}"
bs = js[0]
be = je[0]

# CHP の削除 API は既定で user.proxy_spec（ユーザー名サブドメイン）を使うため、
# job<JOBID>.<domain> に差し替えた spawner.proxy_spec を確実に削除する
_orig_proxy_delete_user = Proxy.delete_user


async def _hpc_proxy_delete_user(self, user, server_name="", client=None):
    sp = user.spawners.get(server_name)
    if sp is not None:
        alias = getattr(sp, "_hpc_public_alias_routespec", None)
        if alias:
            self.log.info("Removing user %s CHP public-alias (%s)", user.name, alias)
            try:
                await self.delete_route(alias)
            except Exception:
                self.log.exception("HPC: failed to delete alias route %s", alias)
    if sp is not None and getattr(sp, "proxy_spec", None):
        routespec = sp.proxy_spec
    else:
        routespec = user.proxy_spec
        if server_name:
            routespec = url_path_join(user.proxy_spec, url_escape_path(server_name), "/")
    self.log.info("Removing user %s from proxy (%s)", user.name, routespec)
    await self.delete_route(routespec)


Proxy.delete_user = _hpc_proxy_delete_user


c.HPCSlurmSpawner.batch_script = f"""#!/bin/bash
#SBATCH --job-name=jhub-app
#SBATCH --partition={bs}partition{be}
#SBATCH --cpus-per-task={bs}nprocs{be}
#SBATCH --mem={bs}memory{be}
#SBATCH --time={bs}runtime{be}
#SBATCH --chdir={bs}homedir{be}
#SBATCH --output=/tmp/jupyterhub-%j.log
{bs}gres_line{be}

set -euo pipefail
export PATH=/opt/jupyterhub/venv/bin:$PATH

# 環境によっては JUPYTERHUB_API_TOKEN が空で JPY_API_TOKEN のみ渡るため補完する
_hub_token="$(printenv JUPYTERHUB_API_TOKEN || true)"
_jpy_token="$(printenv JPY_API_TOKEN || true)"
if [ -z "$_hub_token" ] && [ -n "$_jpy_token" ]; then
    export JUPYTERHUB_API_TOKEN="$_jpy_token"
fi

APP_CHOICE="{bs}app_choice{be}"
if [ "$APP_CHOICE" = "open-webui" ]; then
    OPENWEBUI_IMAGE="/opt/images/openwebui-ollama.sif"
    SERVICE_PORT="$(printenv JUPYTERHUB_SERVICE_PORT || true)"
    SERVICE_URL="$(printenv JUPYTERHUB_SERVICE_URL || true)"
    CMDLINE="{bs}cmd{be}"
    PORT="$SERVICE_PORT"
    case "$PORT" in
      ''|*[!0-9]*|0) PORT="" ;;
    esac
    if [ -z "$PORT" ]; then
      PORT="$(printf '%s' "$SERVICE_URL" | sed -n 's#.*:\\([0-9]\\+\\)/.*#\\1#p')"
      if [ "$PORT" = "0" ]; then
        PORT=""
      fi
    fi
    if [ -z "$PORT" ]; then
      PORT="$(printf '%s' "$CMDLINE" | sed -n 's/.*--port=\\([0-9]\\+\\).*/\\1/p')"
    fi
    if [ -z "$PORT" ]; then
      # 環境によっては起動直後の service_url が :0 のまま来るため、JOBID からフォールバックポートを決める
      PORT="$((20000 + ($(printenv SLURM_JOB_ID || echo 0) % 20000)))"
      echo "dynamic port unavailable, fallback to PORT=$PORT (service_port=$SERVICE_PORT service_url=$SERVICE_URL)" >&2
    fi
    # 以前の失敗ジョブの残骸で同一ポートが占有されると OpenWebUI が即終了するため、
    # 同ユーザーの同一ポート open_webui プロセスを掃除してから起動する。
    if ss -ltn "( sport = :$PORT )" | rg -q LISTEN; then
      echo "PORT $PORT already in use; cleaning stale open_webui process" >&2
      pkill -u "$USER" -f "open_webui.main:app --host 0.0.0.0 --port $PORT" || true
      sleep 1
    fi
    if ss -ltn "( sport = :$PORT )" | rg -q LISTEN; then
      echo "PORT $PORT still busy after cleanup; abort startup to avoid immediate crash" >&2
      exit 1
    fi
    OPENWEBUI_DATA_DIR="$HOME/.open-webui-$JUPYTERHUB_SERVER_NAME"
    HF_HOME_DIR="$OPENWEBUI_DATA_DIR/hf"
    HF_HUB_CACHE_DIR="$HF_HOME_DIR/hub"
    SENTENCE_TRANSFORMERS_HOME_DIR="$OPENWEBUI_DATA_DIR/sentence-transformers"
    TRANSFORMERS_CACHE_DIR="$HF_HOME_DIR/transformers"
    mkdir -p "$OPENWEBUI_DATA_DIR/static" "$HOME/.ollama" "$HF_HUB_CACHE_DIR" "$SENTENCE_TRANSFORMERS_HOME_DIR" "$TRANSFORMERS_CACHE_DIR"
    JOB_HOST="job$(printenv SLURM_JOB_ID || echo 0).{{ jupyterhub_job_dns_domain }}"
    WEBUI_EXTERNAL_URL="{{ hpc_public_scheme | default('https') }}://$JOB_HOST/"
    exec apptainer exec --nv "$OPENWEBUI_IMAGE" sh -lc "HOST=0.0.0.0 PORT=$PORT DATA_DIR=$OPENWEBUI_DATA_DIR STATIC_DIR=$OPENWEBUI_DATA_DIR/static OLLAMA_MODELS=$HOME/.ollama/models WEBUI_SECRET_KEY_FILE=$OPENWEBUI_DATA_DIR/.webui_secret_key WEBUI_URL=$WEBUI_EXTERNAL_URL HF_HOME=$HF_HOME_DIR HUGGINGFACE_HUB_CACHE=$HF_HUB_CACHE_DIR SENTENCE_TRANSFORMERS_HOME=$SENTENCE_TRANSFORMERS_HOME_DIR TRANSFORMERS_CACHE=$TRANSFORMERS_CACHE_DIR /app/backend/start.sh"
else
    IMAGE_PATH="/opt/images/jupyter-cpu.sif"
    exec apptainer exec --nv "$IMAGE_PATH" {bs}cmd{be} --ip=0.0.0.0
fi
"""
