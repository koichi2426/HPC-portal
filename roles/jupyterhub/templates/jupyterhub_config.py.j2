    })
        .then(function (r) {
            if (!r.ok && r.status !== 202 && r.status !== 204) throw new Error("stop failed");
            window.location.reload();
        })
        .catch(function () {
            btn.disabled = false;
            btn.textContent = "停止";
            alert("停止に失敗しました。しばらくしてから再度お試しください。");
        });
