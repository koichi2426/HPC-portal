{% raw %}
{% extends "page.html" %}

{% block main %}
<div style="max-width: 980px; margin: 24px auto; padding: 0 16px;">
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
    <h2 style="margin:0;">Home</h2>
    <a id="new-app-btn" href="/hub/new" style="display:inline-block; padding:10px 14px; border-radius:8px; text-decoration:none; background:#1f6feb; color:#fff; font-weight:600;">
      + New Application
    </a>
  </div>

  {% set res = hpc_resource_snapshot %}
  <style>
    .gx10-resource-card { background:#0d1117; border:1px solid #30363d; border-radius:12px; padding:14px; margin-bottom:18px; }
    .gx10-resource-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:12px; margin-top:12px; }
    .gx10-resource-meter { background:rgba(255,255,255,0.035); border:1px solid rgba(255,255,255,0.08); border-radius:10px; padding:10px; }
    .gx10-meter-head { display:flex; justify-content:space-between; align-items:center; color:#8b949e; font-size:12px; margin-bottom:8px; }
    .gx10-meter-status { color:#9be7c7; font-weight:700; }
    .gx10-meter-track { height:10px; background:#30363d; border-radius:999px; overflow:hidden; }
    .gx10-meter-fill { height:100%; border-radius:999px; background:linear-gradient(90deg, #00f2fe, #4facfe, #9be7c7); }
    .gx10-meter-numbers { display:flex; justify-content:space-between; margin-top:7px; color:#8b949e; font-size:11px; }
    .gx10-app-card { border:1px solid #30363d; border-radius:10px; margin-bottom:10px; background:#0d1117; overflow:hidden; }
    .gx10-app-card-link { display:block; padding:12px; text-decoration:none; color:inherit; }
    .gx10-app-card-link:hover { background:rgba(88,166,255,0.06); }
    .gx10-app-card-actions { display:flex; gap:8px; align-items:center; padding:0 12px 12px; justify-content:flex-end; }
    .gx10-detail-hint { font-size:11px; color:#58a6ff; margin-top:6px; }
    [data-hpc-resource-meter] [data-resource-updated-at].hpc-resource-live { color:#3fb950; font-weight:600; }
    [data-hpc-resource-meter] [data-resource-updated-at].hpc-resource-stale { color:#f85149; font-weight:600; }
    [data-hpc-resource-meter] [data-resource-updated-at].hpc-resource-loading { color:#e3b341; }
    [data-hpc-resource-meter].hpc-resource-refreshed .gx10-meter-fill { filter:brightness(1.15); transition:width 0.35s ease, filter 0.2s ease; }
  </style>
  <div class="gx10-resource-card" data-hpc-resource-meter>
    <div style="display:flex; justify-content:space-between; align-items:center; gap:12px;">
      <div>
        <div style="font-weight:700; color:#c9d1d9;">現在使えるリソース</div>
        <div style="font-size:12px; color:#8b949e; margin-top:3px;">Node: gx10-ac12</div>
      </div>
      <div style="text-align:right;">
        <div data-resource-updated-at style="font-size:11px; color:#8b949e; margin-bottom:4px;">5秒ごとに自動更新</div>
        <a href="/hub/new" style="text-decoration:none; color:#58a6ff; font-weight:700; font-size:12px;">新規起動へ →</a>
      </div>
    </div>
    <div class="gx10-resource-grid" aria-label="現在使えるリソース">
      <div class="gx10-resource-meter">
        <div class="gx10-meter-head"><span>CPU 空き</span><span class="gx10-meter-status" data-resource-text="cpu_status">{{ res.cpu_status }}</span></div>
        <div class="gx10-meter-track"><div class="gx10-meter-fill" data-resource-width="cpu_available" style="width:{{ "%.0f"|format(res.cpu_available) }}%;"></div></div>
        <div class="gx10-meter-numbers">
          <span data-resource-text="cpu_available_count">残り {{ "%.1f"|format(res.cpu_available_count) }} vCPU</span>
          <span data-resource-text="cpu_total">最大 {{ res.cpu_total }} vCPU</span>
        </div>
      </div>
      <div class="gx10-resource-meter">
        <div class="gx10-meter-head"><span>RAM 空き</span><span class="gx10-meter-status" data-resource-text="mem_status">{{ res.mem_status }}</span></div>
        <div class="gx10-meter-track"><div class="gx10-meter-fill" data-resource-width="mem_available" style="width:{{ "%.0f"|format(res.mem_available) }}%;"></div></div>
        <div class="gx10-meter-numbers">
          <span data-resource-text="mem_available_gb">残り {{ "%.1f"|format(res.mem_available_gb) }} GB</span>
          <span data-resource-text="mem_total_gb">最大 {{ "%.1f"|format(res.mem_total_gb) }} GB</span>
        </div>
      </div>
      <div class="gx10-resource-meter">
        <div class="gx10-meter-head"><span>Storage 空き</span><span class="gx10-meter-status" data-resource-text="disk_status">{{ res.disk_status }}</span></div>
        <div class="gx10-meter-track"><div class="gx10-meter-fill" data-resource-width="disk_available" style="width:{{ "%.0f"|format(res.disk_available) }}%;"></div></div>
        <div class="gx10-meter-numbers">
          <span data-resource-text="disk_available_gb">残り {{ "%.1f"|format(res.disk_available_gb) }} GB</span>
          <span data-resource-text="disk_total_gb">最大 {{ "%.1f"|format(res.disk_total_gb) }} GB</span>
        </div>
      </div>
      <div class="gx10-resource-meter">
        <div class="gx10-meter-head"><span>GPU 空き</span><span class="gx10-meter-status" data-resource-text="gpu_status">{{ res.gpu_status }}</span></div>
        <div class="gx10-meter-track"><div class="gx10-meter-fill" data-resource-width="gpu_available" style="width:{{ "%.0f"|format(res.gpu_available) }}%;"></div></div>
        <div class="gx10-meter-numbers">
          <span data-resource-text="gpu_available_count">空き {{ res.gpu_available_count }}/{{ res.gpu_max }} GPU</span>
          <span data-resource-text="gpu_vram_available_gb">VRAM {{ "%.1f"|format(res.gpu_vram_available_gb) }}/{{ "%.1f"|format(res.gpu_vram_total_gb) }} GB</span>
        </div>
      </div>
    </div>
  </div>

  <div style="margin-bottom:10px; color:#8b949e;">起動中のアプリケーション</div>

  {% if user and user.spawners %}
    {% set has_any = false %}
    {% for name, spawner in user.spawners.items() %}
      {% if spawner.active or spawner.pending %}
        {% set has_any = true %}
        {% set sp_public_url = spawner.public_url if spawner.public_url is defined else '' %}
        {% set _uo = spawner.user_options if spawner.user_options is defined else {} %}
        {% set is_openwebui = _uo.get('app_choice') == 'open-webui' if _uo else false %}
        {% if is_openwebui %}
          {% set app_label = 'Open WebUI' %}
        {% elif _uo.get('app_choice') in ['jupyterlab', 'jupyter'] %}
          {% set app_label = 'JupyterLab' %}
        {% elif name %}
          {% set app_label = name %}
        {% else %}
          {% set app_label = 'default' %}
        {% endif %}
        {% set _cpu = _uo.get('nprocs', '—') %}
        {% set _mem = _uo.get('memory', '—') %}
        {% set _gpu = (_uo.get('gpu', '0') or '0')|int %}
        {% set _rt = _uo.get('runtime', '—') %}
        {% if (_rt|string)|upper in ['UNLIMITED', 'INFINITE'] %}
        {% set _hours = '無制限' %}
        {% elif ':' in (_rt|string) %}
        {% set _hours = _rt.split(':')[0]|int ~ 'h' %}
        {% else %}
        {% set _hours = _rt %}
        {% endif %}
        {% set _gpu_label = (_gpu|string ~ ' GPU') if _gpu > 0 else 'GPU なし' %}
        {% set alloc_line = _cpu ~ ' vCPU · ' ~ _mem ~ ' RAM · ' ~ _gpu_label ~ ' · ' ~ _hours %}
        {% set sn_path = name if name else '__default__' %}
        {# spawn 直後に public_url が古いまま残ることがあるため、起動済み+JOBID では job<JOBID> + ORM base_url を優先。
           Hub/OAuth は gx10 のままだが、CHP に gx10 用エイリアスルートも載せるため job の JUMP でも整合する。 #}
        {% if is_openwebui and spawner.job_id %}
          {% set job_url = sp_public_url if sp_public_url else (hpc_public_scheme + '://job' + spawner.job_id|string + '.' + hpc_job_dns_domain + '/') %}
        {% elif spawner.active and spawner.job_id %}
          {% if spawner.server and spawner.server.base_url %}
            {% set _raw = spawner.server.base_url|string %}
            {% set _p = _raw if _raw.endswith('/') else (_raw ~ '/') %}
            {% set job_url = hpc_public_scheme + '://job' + spawner.job_id|string + '.' + hpc_job_dns_domain + _p %}
          {% elif name %}
            {% set job_url = hpc_public_scheme + '://job' + spawner.job_id|string + '.' + hpc_job_dns_domain + '/user/' + user.escaped_name + '/' + name + '/' %}
          {% else %}
            {% set job_url = hpc_public_scheme + '://job' + spawner.job_id|string + '.' + hpc_job_dns_domain + '/user/' + user.escaped_name + '/' %}
          {% endif %}
        {% elif sp_public_url %}
          {% set job_url = sp_public_url %}
        {% elif spawner.job_id and spawner.pending %}
          {% if name %}
            {% set job_url = hpc_public_scheme + '://job' + spawner.job_id|string + '.' + hpc_job_dns_domain + '/user/' + user.escaped_name + '/' + name + '/' %}
          {% else %}
            {% set job_url = hpc_public_scheme + '://job' + spawner.job_id|string + '.' + hpc_job_dns_domain + '/user/' + user.escaped_name + '/' %}
          {% endif %}
        {% else %}
          {% if name %}
            {% set job_url = '/user/' + user.escaped_name + '/' + name + '/' %}
          {% else %}
            {% set job_url = '/user/' + user.escaped_name + '/' %}
          {% endif %}
        {% endif %}

        <div class="gx10-app-card" {% if spawner.pending %}data-gx10-pending="1"{% endif %}>
          <a class="gx10-app-card-link" href="/hub/apps/{{ sn_path }}">
            <div>
              <div style="font-weight:600; color:#c9d1d9;">{{ app_label }}{% if spawner.job_id %} <span style="color:#8b949e;font-size:11px;">(job {{ spawner.job_id }})</span>{% endif %}</div>
              <div style="font-size:11px; color:#8b949e; margin-top:6px;">割り当て: {{ alloc_line }}</div>
              {% if spawner.pending %}
                <div style="font-size:12px; color:#e3b341; margin-top:4px;">Pending / Starting… ({{ spawner.pending }})</div>
                <div style="margin-top:8px; height:6px; background:#30363d; border-radius:999px;">
                  <div style="width:55%; height:100%; background:#e3b341; border-radius:999px;"></div>
                </div>
              {% else %}
                <div style="font-size:12px; color:#3fb950; margin-top:4px;">Running</div>
              {% endif %}
              <div class="gx10-detail-hint">詳細を見る →</div>
            </div>
          </a>
          {% if spawner.active %}
          <div class="gx10-app-card-actions">
            <a href="{{ job_url }}" target="_blank" rel="noopener noreferrer" style="text-decoration:none; color:#58a6ff; font-weight:700; font-size:12px;" onclick="event.stopPropagation();">
              JUMP ↗
            </a>
          </div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}

  {% else %}
  {% endif %}
</div>
{% endblock %}

{% block script %}
<script src="/hub/hpc-resource-meter.js?v=2"></script>
<script>
(function () {
  var pollMs = 4000;
  var lastSig = null;
  function readCookie(name) {
    var m = document.cookie.match(new RegExp('(?:^|; )' + name.replace(/[.$?*|{}()\\[\\]\\\\/+^]/g, '\\$&') + '=([^;]*)'));
    return m ? decodeURIComponent(m[1]) : '';
  }
  function tick() {
    var xsrf = readCookie("_xsrf");
    fetch("/hub/api/user", {
      credentials: "same-origin",
      headers: xsrf ? { "X-XSRFToken": xsrf } : {}
    })
      .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
      .then(function (data) {
        var servers = data.servers || {};
        var sig = JSON.stringify(servers);
        if (lastSig === null) {
          lastSig = sig;
        } else if (lastSig !== sig) {
          window.location.reload();
          return;
        }
        lastSig = sig;
      })
      .catch(function () {});
  }
  tick();
  setInterval(tick, pollMs);
})();
</script>
{% endblock %}
{% endraw %}
