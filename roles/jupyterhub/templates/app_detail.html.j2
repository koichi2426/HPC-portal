{% raw %}
{% extends "page.html" %}

{% block main %}
{% set d = detail %}
{% set res = node_resources %}
{% set live_status = 'pending' if (d.status == 'pending' or (d.shared_ollama and d.active and not d.api)) else d.status %}
{% set live_status_label = '起動中 / API応答待ち' if (d.shared_ollama and d.active and not d.api) else d.status_label %}
<div class="gx10-app-detail-page" data-hpc-user="{{ user.name }}"
     {% if d.shared_ollama %}data-hpc-shared-ollama-status{% else %}data-hpc-app-status data-server-name="{{ d.server_name }}"{% endif %}
     data-hpc-app-state="{{ live_status }}">
  <div style="margin-bottom: 20px;">
    <a class="hpc-back-link" href="/hub/home">← Home</a>
  </div>

  <div class="hpc-heading-row">
    <div>
      <h2 class="hpc-page-title">{{ d.app_label }}</h2>
      <div class="hpc-help">サーバー名: <code>{{ d.server_name or '(default)' }}</code></div>
    </div>
    <span data-hpc-app-status-badge class="hpc-status-badge {% if live_status == 'running' %}running{% elif live_status == 'pending' %}pending{% endif %}">
      {{ live_status_label }}
    </span>
  </div>

  <div class="gx10-detail-card" data-hpc-resource-meter>
    <div class="hpc-row-between">
      <div class="hpc-section-title">ノードの空きリソース</div>
      <span class="hpc-refresh-status" data-resource-refresh-status aria-live="polite">
        <span class="hpc-refresh-spinner" aria-hidden="true"></span>
        <span data-resource-updated-at>最終更新 --:--:--</span>
        <span class="visually-hidden" data-resource-refresh-live>取得中</span>
      </span>
    </div>
    <div class="hpc-muted" style="font-size:11px; margin-top:4px;">Node: gx10-ac12（Slurm 割当ベース）</div>
    <div class="gx10-resource-grid compact" aria-label="ノードの空きリソース">
      <div class="gx10-resource-meter">
        <div class="gx10-meter-head"><span>CPU</span><span class="gx10-meter-status" data-resource-text="cpu_status">{{ res.cpu_status }}</span></div>
        <div class="gx10-meter-track"><div class="gx10-meter-fill" data-resource-width="cpu_available" style="width:{{ "%.0f"|format(res.cpu_available) }}%;"></div></div>
        <div class="gx10-meter-numbers">
          <span data-resource-text="cpu_available_count">残り {{ "%.1f"|format(res.cpu_available_count) }} vCPU</span>
          <span data-resource-text="cpu_total">最大 {{ res.cpu_total }} vCPU</span>
        </div>
      </div>
      <details class="gx10-resource-meter hpc-unified-memory hpc-resource-menu">
        <summary class="hpc-unified-memory-summary" aria-label="統合メモリの説明を開く">
          <div class="gx10-meter-head"><span class="hpc-resource-label">統合メモリ 空き</span><span class="gx10-meter-status" data-resource-text="mem_status">{{ res.mem_status }}</span></div>
          <div class="gx10-meter-track"><div class="gx10-meter-fill" data-resource-width="mem_available" style="width:{{ "%.0f"|format(res.mem_available) }}%;"></div></div>
          <div class="gx10-meter-numbers"><span data-resource-text="mem_available_gb">残り {{ "%.1f"|format(res.mem_available_gb) }} GB</span><span data-resource-text="mem_total_gb">最大 {{ "%.1f"|format(res.mem_total_gb) }} GB</span></div>
        </summary>
        <div class="hpc-unified-memory-panel">
          <strong>統合メモリについて</strong>
          <p>CPUとGPUが共有して使用するメモリです。GPU専用VRAMはありません。</p>
          <dl><div><dt>使用中</dt><dd data-resource-text="mem_used_gb">{{ "%.1f"|format(res.mem_used_gb) }} GB</dd></div><div><dt>空き</dt><dd data-resource-text="mem_available_gb">残り {{ "%.1f"|format(res.mem_available_gb) }} GB</dd></div><div><dt>最大</dt><dd data-resource-text="mem_total_gb">最大 {{ "%.1f"|format(res.mem_total_gb) }} GB</dd></div></dl>
          <p class="hpc-unified-memory-note">Slurmで指定するメモリは上限です。起動時に全容量が消費されるわけではありません。</p>
        </div>
      </details>
      <div class="gx10-resource-meter">
        <div class="gx10-meter-head"><span>Storage</span><span class="gx10-meter-status" data-resource-text="disk_status">{{ res.disk_status }}</span></div>
        <div class="gx10-meter-track"><div class="gx10-meter-fill" data-resource-width="disk_available" style="width:{{ "%.0f"|format(res.disk_available) }}%;"></div></div>
        <div class="gx10-meter-numbers">
          <span data-resource-text="disk_available_gb">残り {{ "%.1f"|format(res.disk_available_gb) }} GB</span>
          <span data-resource-text="disk_total_gb">最大 {{ "%.1f"|format(res.disk_total_gb) }} GB</span>
        </div>
      </div>
      <details class="gx10-resource-meter hpc-gpu-processes">
        <summary><span>GPU</span><span class="hpc-gpu-process-summary" data-gpu-process-count aria-live="polite">{% if res.gpu_processes_available %}利用中 {{ res.gpu_process_count }}件{% else %}取得できません{% endif %}</span></summary>
        <ul class="hpc-gpu-process-list" data-gpu-process-list>
          {% if not res.gpu_processes_available %}
          <li class="hpc-gpu-process-empty">GPUプロセス情報を取得できません</li>
          {% elif res.gpu_processes %}
            {% for process in res.gpu_processes %}
            <li class="hpc-gpu-process-item"><span class="hpc-gpu-process-name">{{ process.name }}</span><span class="hpc-gpu-process-meta">{{ process.username }} · PID {{ process.pid }}</span></li>
            {% endfor %}
          {% else %}
          <li class="hpc-gpu-process-empty">GPUを使用中のプロセスはありません</li>
          {% endif %}
        </ul>
      </details>
    </div>
  </div>

  <div class="gx10-detail-card">
    <div class="hpc-section-title" style="margin-bottom:12px;">このアプリの割り当て（Slurm 要求値）</div>
    <table class="gx10-detail-table" aria-label="割り当てリソース">
      <tr><th>アプリ種別</th><td>{{ d.app_label }} <span class="hpc-muted">({{ d.app_choice }})</span></td></tr>
      <tr><th>vCPU</th><td>{{ d.allocation['cpu'] }}</td></tr>
      <tr><th>メモリ</th><td>{{ d.allocation['memory'] }}</td></tr>
      <tr><th>GPU</th><td>{{ d.allocation['gpu_label'] }}</td></tr>
      <tr><th>最大実行時間</th><td>{{ d.allocation['runtime'] }} <span class="hpc-muted">({{ d.allocation['hours'] }})</span></td></tr>
      {% if d.app_choice == 'open-webui' %}
      <tr data-hpc-openwebui-version-url="/hub/apps/{{ d.server_name_path }}/version">
        <th>バージョン</th>
        <td class="hpc-app-version">
          <span data-hpc-running-version-label>起動中</span>:
          <strong data-hpc-running-version>{% if d.openwebui_version %}v{{ d.openwebui_version }}{% else %}確認中{% endif %}</strong>
          <span aria-hidden="true">·</span>
          新規起動: <strong data-hpc-target-version>v{{ d.openwebui_target_version }}</strong>
          <span class="hpc-version-update" data-hpc-version-update hidden>再起動で更新</span>
        </td>
      </tr>
      {% elif not d.shared_ollama %}
      <tr>
        <th>環境バージョン</th>
        <td class="hpc-app-version">
          起動時: <strong>{% if d.ubuntu_version %}Ubuntu {{ d.ubuntu_version }}{% else %}不明{% endif %}</strong>
          <span aria-hidden="true">·</span>
          新規起動: <strong>Ubuntu {{ d.ubuntu_target_version }}</strong>
          {% if d.ubuntu_version and d.ubuntu_version != d.ubuntu_target_version %}<span class="hpc-version-update">再起動で更新</span>{% endif %}
        </td>
      </tr>
      {% endif %}
    </table>
  </div>

  <div class="gx10-detail-card">
    <div class="hpc-section-title" style="margin-bottom:12px;">ジョブ・接続</div>
    <table class="gx10-detail-table">
      <tr><th>Slurm JOB ID</th><td>{% if d.job_id %}{{ d.job_id }}{% else %}<span class="hpc-muted">—</span>{% endif %}</td></tr>
      {% if d.shared_ollama %}
      <tr><th>API</th><td><span data-hpc-ollama-api-status class="{% if d.api %}hpc-status-ok{% else %}hpc-status-warn{% endif %}">{% if d.api %}OK{% else %}起動待ち / 未応答{% endif %}</span></td></tr>
      <tr><th>バージョン</th><td class="hpc-app-version">起動中: <strong data-hpc-ollama-running-version>{% if d.version %}v{{ d.version }}{% else %}確認中{% endif %}</strong> <span aria-hidden="true">·</span> 新規起動: <strong data-hpc-ollama-target-version>v{{ d.target_version }}</strong><span class="hpc-version-update" data-hpc-ollama-version-update {% if not d.update_available %}hidden{% endif %}>再起動で更新</span></td></tr>
      <tr><th>Port</th><td>{{ d.port }}</td></tr>
      <tr><th>Models dir</th><td><code style="font-size:11px;">{{ d.models_dir }}</code></td></tr>
      {% if d.status_error %}
      <tr><th>Warning</th><td class="hpc-status-warn">{{ d.status_error }}</td></tr>
      {% endif %}
      {% else %}
      <tr><th>ジョブホスト</th><td>{% if d.job_host %}{{ d.job_host }}{% else %}<span class="hpc-muted">—</span>{% endif %}</td></tr>
      <tr><th>Hub ポート</th><td>{% if d.port %}{{ d.port }}{% else %}<span class="hpc-muted">—</span>{% endif %}</td></tr>
      <tr><th>公開 URL</th><td>{% if d.job_url %}<a class="hpc-external-link" href="{{ d.job_url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ d.job_url }}（新しいタブで開く）"><span>{{ d.job_url }}</span><svg class="hpc-external-link-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3h7v7M10 14 21 3M21 14v7H3V3h7"/></svg></a>{% else %}<span class="hpc-muted">—</span>{% endif %}</td></tr>
      {% if d.proxy_spec %}
      <tr><th>Proxy route</th><td><code style="font-size:11px;">{{ d.proxy_spec }}</code></td></tr>
      {% endif %}
      {% endif %}
    </table>
  </div>

  {% if d.shared_ollama %}
  <div class="gx10-detail-card">
    <div class="hpc-row-between" style="margin-bottom:12px;">
      <div class="hpc-section-title">Ollama モデル</div>
      <div class="hpc-row">
        {% if hpc_litellm_admin_url %}
        <a class="gx10-primary-btn hpc-external-link" href="{{ hpc_litellm_admin_url }}" target="_blank" rel="noopener noreferrer" aria-label="LiteLLM 管理画面を新しいタブで開く"><span>LiteLLM 管理画面</span><svg class="hpc-external-link-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3h7v7M10 14 21 3M21 14v7H3V3h7"/></svg></a>
        {% endif %}
        <button type="button" class="gx10-primary-btn" onclick="window.location.reload()">更新</button>
      </div>
    </div>
    {% if d.models %}
      <table class="gx10-detail-table">
        {% for model in d.models %}
        <tr>
          <th>{{ model.name }}</th>
          <td>
            {% if model.size %}<span class="hpc-muted">{{ model.size }}</span>{% endif %}
            <button type="button" class="gx10-delete-btn" style="padding:6px 10px; font-size:12px; float:right;" data-model="{{ model.name }}" onclick="hpcOllamaDelete(this)">delete</button>
          </td>
        </tr>
        {% endfor %}
      </table>
    {% else %}
      <div class="hpc-empty">モデルはまだありません。</div>
    {% endif %}
    <div class="hpc-help" style="margin-top:14px;">
      モデル名は <a class="hpc-external-link" href="https://ollama.com/library" target="_blank" rel="noopener noreferrer" aria-label="Ollama libraryを新しいタブで開く"><span>Ollama library</span><svg class="hpc-external-link-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3h7v7M10 14 21 3M21 14v7H3V3h7"/></svg></a> で確認できます。
    </div>
    <div class="hpc-row" style="margin-top:14px;">
      <input id="ollama-pull-model" type="text" placeholder="例: llama3.1:8b" style="flex:1; min-width:0; border-radius:8px; padding:10px;">
      <button id="ollama-pull-button" type="button" class="gx10-primary-btn" onclick="hpcOllamaPull(this)">Pull</button>
    </div>
    <div id="ollama-action-msg" class="hpc-help" style="margin-top:10px;"></div>
    <div id="ollama-pull-progress" class="gx10-pull-progress" hidden aria-live="polite">
      <div id="ollama-pull-progress-text" class="hpc-help">ダウンロードを準備中…</div>
      <div class="hpc-progress"><div id="ollama-pull-progress-fill" class="hpc-progress-fill"></div></div>
    </div>
    <button id="ollama-register-retry" type="button" class="gx10-primary-btn gx10-model-register-retry" hidden onclick="hpcOllamaRegisterRetry(this)">LiteLLM登録を再試行</button>
  </div>
  {% endif %}

  <div data-hpc-app-progress class="hpc-progress hpc-progress-indeterminate" {% if live_status != 'pending' %}hidden{% endif %} role="progressbar" aria-label="アプリを起動しています"><div class="hpc-progress-fill"></div></div>

  <div class="gx10-actions">
    {% if d.shared_ollama %}
    {% if d.active %}
    <button type="button" class="gx10-delete-btn" onclick="hpcOllamaStop(this)">停止</button>
    {% endif %}
    {% else %}
    {% if d.active and d.job_url %}
    <a class="gx10-primary-btn hpc-external-link" href="{{ d.job_url }}" target="_blank" rel="noopener noreferrer" aria-label="アプリを新しいタブで開く"><span>アプリを開く (JUMP)</span><svg class="hpc-external-link-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3h7v7M10 14 21 3M21 14v7H3V3h7"/></svg></a>
    {% endif %}
    <button type="button" class="gx10-delete-btn" data-server-name="{{ d.server_name }}" onclick="hpcDeleteApp(this)">削除</button>
    {% endif %}
  </div>
</div>
{% endblock %}

{% block script %}
<script src="/hub/hpc-js/core.js?v={{ hpc_static_versions['js/core.js'] }}"></script>
<script src="/hub/hpc-js/resource-meter.js?v={{ hpc_static_versions['js/resource-meter.js'] }}"></script>
<script src="/hub/hpc-js/app-status.js?v={{ hpc_static_versions['js/app-status.js'] }}"></script>
<script src="/hub/hpc-js/app-detail.js?v={{ hpc_static_versions['js/app-detail.js'] }}"></script>
{% if d.shared_ollama %}
<script src="/hub/hpc-js/ollama-admin.js?v={{ hpc_static_versions['js/ollama-admin.js'] }}"></script>
{% endif %}
{% endblock %}
{% endraw %}
