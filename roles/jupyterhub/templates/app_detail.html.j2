{% raw %}
{% extends "page.html" %}

{% block main %}
{% set d = detail %}
{% set res = node_resources %}
<div class="gx10-app-detail-page" style="max-width: 720px; margin: 24px auto; padding: 0 16px 32px; color:#c9d1d9;">
  <div style="margin-bottom: 20px;">
    <a href="/hub/home" style="color:#8b949e; text-decoration:none; font-size:13px;">← Home</a>
  </div>

  <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:16px; margin-top:12px;">
    <div>
      <h2 style="margin:0 0 6px; color:#c9d1d9;">{{ d.app_label }}</h2>
      <div style="font-size:12px; color:#8b949e;">サーバー名: <code style="color:#c9d1d9;">{{ d.server_name or '(default)' }}</code></div>
    </div>
    <span style="font-size:12px; font-weight:700; padding:4px 10px; border-radius:999px; {% if d.status == 'running' %}background:rgba(63,185,80,0.15); color:#3fb950; border:1px solid rgba(63,185,80,0.35);{% elif d.status == 'pending' %}background:rgba(227,179,65,0.15); color:#e3b341; border:1px solid rgba(227,179,65,0.35);{% else %}background:#30363d; color:#8b949e;{% endif %}">
      {{ d.status_label }}
    </span>
  </div>

  <style>
    .gx10-app-detail-page .gx10-detail-card { background:#161b22; border:1px solid #30363d; border-radius:12px; padding:16px; margin-top:16px; }
    .gx10-app-detail-page .gx10-detail-table { width:100%; border-collapse:collapse; font-size:13px; }
    .gx10-app-detail-page .gx10-detail-table th { text-align:left; color:#8b949e; font-weight:600; padding:8px 12px 8px 0; width:38%; vertical-align:top; }
    .gx10-app-detail-page .gx10-detail-table td { color:#c9d1d9; padding:8px 0; word-break:break-all; }
    .gx10-app-detail-page .gx10-delete-btn { background:#da3633; border:1px solid #f85149; color:#fff; border-radius:8px; padding:10px 18px; font-size:14px; font-weight:600; cursor:pointer; }
    .gx10-app-detail-page .gx10-delete-btn:hover:not(:disabled) { background:#b62324; }
    .gx10-app-detail-page .gx10-delete-btn:disabled { opacity:0.6; cursor:wait; }
    .gx10-app-detail-page .gx10-primary-btn { display:inline-block; padding:10px 18px; border-radius:8px; text-decoration:none; background:#1f6feb; color:#fff; font-weight:600; font-size:14px; }
    .gx10-app-detail-page .gx10-actions { display:flex; flex-wrap:wrap; gap:10px; margin-top:20px; align-items:center; }
    .gx10-app-detail-page .gx10-resource-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(150px, 1fr)); gap:10px; margin-top:12px; }
    .gx10-app-detail-page .gx10-resource-meter { background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.08); border-radius:10px; padding:10px; }
    .gx10-app-detail-page .gx10-meter-head { display:flex; justify-content:space-between; align-items:center; color:#8b949e; font-size:11px; margin-bottom:8px; }
    .gx10-app-detail-page .gx10-meter-status { color:#9be7c7; font-weight:700; font-size:11px; }
    .gx10-app-detail-page .gx10-meter-track { height:8px; background:#30363d; border-radius:999px; overflow:hidden; }
    .gx10-app-detail-page .gx10-meter-fill { height:100%; border-radius:999px; background:linear-gradient(90deg, #00f2fe, #4facfe, #9be7c7); }
    .gx10-app-detail-page .gx10-meter-numbers { display:flex; justify-content:space-between; margin-top:6px; color:#8b949e; font-size:10px; }
  </style>

  <div class="gx10-detail-card">
    <div style="display:flex; justify-content:space-between; align-items:center; gap:12px;">
      <div style="font-weight:700; color:#c9d1d9;">ノードの空きリソース</div>
      <div data-resource-updated-at style="font-size:11px; color:#8b949e;">5秒ごとに自動更新</div>
    </div>
    <div style="font-size:11px; color:#8b949e; margin-top:4px;">Node: gx10-ac12（Slurm 割当ベース）</div>
    <div class="gx10-resource-grid" aria-label="ノードの空きリソース">
      <div class="gx10-resource-meter">
        <div class="gx10-meter-head"><span>CPU</span><span class="gx10-meter-status" data-resource-text="cpu_status">{{ res.cpu_status }}</span></div>
        <div class="gx10-meter-track"><div class="gx10-meter-fill" data-resource-width="cpu_available" style="width:{{ "%.0f"|format(res.cpu_available) }}%;"></div></div>
        <div class="gx10-meter-numbers">
          <span data-resource-text="cpu_available_count">残り {{ "%.1f"|format(res.cpu_available_count) }} vCPU</span>
          <span data-resource-text="cpu_total">最大 {{ res.cpu_total }} vCPU</span>
        </div>
      </div>
      <div class="gx10-resource-meter">
        <div class="gx10-meter-head"><span>RAM</span><span class="gx10-meter-status" data-resource-text="mem_status">{{ res.mem_status }}</span></div>
        <div class="gx10-meter-track"><div class="gx10-meter-fill" data-resource-width="mem_available" style="width:{{ "%.0f"|format(res.mem_available) }}%;"></div></div>
        <div class="gx10-meter-numbers">
          <span data-resource-text="mem_available_gb">残り {{ "%.1f"|format(res.mem_available_gb) }} GB</span>
          <span data-resource-text="mem_total_gb">最大 {{ "%.1f"|format(res.mem_total_gb) }} GB</span>
        </div>
      </div>
      <div class="gx10-resource-meter">
        <div class="gx10-meter-head"><span>Storage</span><span class="gx10-meter-status" data-resource-text="disk_status">{{ res.disk_status }}</span></div>
        <div class="gx10-meter-track"><div class="gx10-meter-fill" data-resource-width="disk_available" style="width:{{ "%.0f"|format(res.disk_available) }}%;"></div></div>
        <div class="gx10-meter-numbers">
          <span data-resource-text="disk_available_gb">残り {{ "%.1f"|format(res.disk_available_gb) }} GB</span>
          <span data-resource-text="disk_total_gb">最大 {{ "%.1f"|format(res.disk_total_gb) }} GB</span>
        </div>
      </div>
      <div class="gx10-resource-meter">
        <div class="gx10-meter-head"><span>GPU</span><span class="gx10-meter-status" data-resource-text="gpu_status">{{ res.gpu_status }}</span></div>
        <div class="gx10-meter-track"><div class="gx10-meter-fill" data-resource-width="gpu_available" style="width:{{ "%.0f"|format(res.gpu_available) }}%;"></div></div>
        <div class="gx10-meter-numbers">
          <span data-resource-text="gpu_available_count">空き {{ res.gpu_available_count }}/{{ res.gpu_max }} GPU</span>
          <span data-resource-text="gpu_vram_available_gb">VRAM {{ "%.1f"|format(res.gpu_vram_available_gb) }}/{{ "%.1f"|format(res.gpu_vram_total_gb) }} GB</span>
        </div>
      </div>
    </div>
  </div>

  <div class="gx10-detail-card">
    <div style="font-weight:700; color:#c9d1d9; margin-bottom:12px;">このアプリの割り当て（Slurm 要求値）</div>
    <table class="gx10-detail-table" aria-label="割り当てリソース">
      <tr><th>アプリ種別</th><td>{{ d.app_label }} <span style="color:#8b949e;">({{ d.app_choice }})</span></td></tr>
      <tr><th>vCPU</th><td>{{ d.allocation['cpu'] }}</td></tr>
      <tr><th>メモリ</th><td>{{ d.allocation['memory'] }}</td></tr>
      <tr><th>GPU</th><td>{{ d.allocation['gpu_label'] }}</td></tr>
      <tr><th>最大実行時間</th><td>{{ d.allocation['runtime'] }} <span style="color:#8b949e;">({{ d.allocation['hours'] }})</span></td></tr>
    </table>
  </div>

  <div class="gx10-detail-card">
    <div style="font-weight:700; color:#c9d1d9; margin-bottom:12px;">ジョブ・接続</div>
    <table class="gx10-detail-table">
      <tr><th>Slurm JOB ID</th><td>{% if d.job_id %}{{ d.job_id }}{% else %}<span style="color:#8b949e;">—</span>{% endif %}</td></tr>
      <tr><th>ジョブホスト</th><td>{% if d.job_host %}{{ d.job_host }}{% else %}<span style="color:#8b949e;">—</span>{% endif %}</td></tr>
      <tr><th>Hub ポート</th><td>{% if d.port %}{{ d.port }}{% else %}<span style="color:#8b949e;">—</span>{% endif %}</td></tr>
      <tr><th>公開 URL</th><td>{% if d.job_url %}<a href="{{ d.job_url }}" target="_blank" rel="noopener noreferrer" style="color:#58a6ff;">{{ d.job_url }}</a>{% else %}<span style="color:#8b949e;">—</span>{% endif %}</td></tr>
      {% if d.proxy_spec %}
      <tr><th>Proxy route</th><td><code style="font-size:11px;">{{ d.proxy_spec }}</code></td></tr>
      {% endif %}
    </table>
  </div>

  {% if d.status == 'pending' %}
  <div style="margin-top:12px; height:6px; background:#30363d; border-radius:999px;">
    <div style="width:55%; height:100%; background:#e3b341; border-radius:999px;"></div>
  </div>
  {% endif %}

  <div class="gx10-actions">
    {% if d.active and d.job_url %}
    <a class="gx10-primary-btn" href="{{ d.job_url }}" target="_blank" rel="noopener noreferrer">アプリを開く (JUMP) ↗</a>
    {% endif %}
    <button type="button" class="gx10-delete-btn" data-server-name="{{ d.server_name }}" onclick="hpcDeleteApp(this)">削除</button>
  </div>
</div>

<script>
window.HPC_HUB_USER = {{ user.name|tojson }};
function hpcReadXsrf() {
  var m = document.cookie.match(/(?:^|; )_xsrf=([^;]*)/);
  return m ? decodeURIComponent(m[1]) : "";
}
function hpcDeleteApp(btn) {
  if (!btn || btn.disabled) return;
  var serverName = btn.getAttribute("data-server-name") || "";
  if (!confirm("このアプリケーションを削除しますか？\n関連する Slurm ジョブも終了します。")) return;
  var user = window.HPC_HUB_USER;
  if (!user) {
    alert("ユーザー情報を取得できません");
    return;
  }
  var xsrf = hpcReadXsrf();
  var api = serverName
    ? "/hub/api/users/" + encodeURIComponent(user) + "/servers/" + encodeURIComponent(serverName)
    : "/hub/api/users/" + encodeURIComponent(user) + "/server";
  btn.disabled = true;
  btn.textContent = "削除中…";
  fetch(api, {
    method: "DELETE",
    credentials: "same-origin",
    headers: xsrf ? { "X-XSRFToken": xsrf } : {}
  })
    .then(function (r) {
      if (!r.ok && r.status !== 202 && r.status !== 204) throw new Error("delete failed");
      window.location.href = "/hub/home";
    })
    .catch(function () {
      btn.disabled = false;
      btn.textContent = "削除";
      alert("削除に失敗しました。しばらくしてから再度お試しください。");
    });
}
(function () {
  function format1(value) {
    return Number(value || 0).toFixed(1);
  }
  function applyResourceSnapshot(data) {
    var text = {
      cpu_status: data.cpu_status,
      cpu_available_count: "残り " + format1(data.cpu_available_count) + " vCPU",
      cpu_total: "最大 " + (data.cpu_total || 0) + " vCPU",
      mem_status: data.mem_status,
      mem_available_gb: "残り " + format1(data.mem_available_gb) + " GB",
      mem_total_gb: "最大 " + format1(data.mem_total_gb) + " GB",
      disk_status: data.disk_status,
      disk_available_gb: "残り " + format1(data.disk_available_gb) + " GB",
      disk_total_gb: "最大 " + format1(data.disk_total_gb) + " GB",
      gpu_status: data.gpu_status,
      gpu_available_count: "空き " + (data.gpu_available_count || 0) + "/" + (data.gpu_max || 0) + " GPU",
      gpu_vram_available_gb: "VRAM " + format1(data.gpu_vram_available_gb) + "/" + format1(data.gpu_vram_total_gb) + " GB"
    };
    document.querySelectorAll(".gx10-app-detail-page [data-resource-text]").forEach(function (el) {
      var key = el.getAttribute("data-resource-text");
      if (text[key] !== undefined) el.textContent = text[key];
    });
    document.querySelectorAll(".gx10-app-detail-page [data-resource-width]").forEach(function (el) {
      var key = el.getAttribute("data-resource-width");
      var pct = Math.max(0, Math.min(100, Number(data[key] || 0)));
      el.style.width = pct.toFixed(0) + "%";
    });
    document.querySelectorAll(".gx10-app-detail-page [data-resource-updated-at]").forEach(function (el) {
      el.textContent = "最終更新 " + new Date().toLocaleTimeString();
    });
  }
  function refreshResourceSnapshot() {
    fetch("/hub/hpc-resource-status", { credentials: "same-origin", cache: "no-store" })
      .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
      .then(applyResourceSnapshot)
      .catch(function () {});
  }
  refreshResourceSnapshot();
  setInterval(refreshResourceSnapshot, 5000);
})();
</script>
{% endblock %}
{% endraw %}
