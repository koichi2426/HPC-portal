{% raw %}
{% extends "page.html" %}

{% block main %}
<div class="hpc-page" style="max-width:720px;">
  <div style="margin-bottom:20px;">
    <a class="hpc-back-link" href="/hub/home">← Home</a>
    <h2 class="hpc-page-title" style="margin-top:10px;">パスワード変更</h2>
    <div class="hpc-help">HPCポータルへのログインに使うLinuxパスワードを変更します。変更は任意です。</div>
  </div>

  <div class="gx10-admin-card">
    <form id="hpc-own-password-form" onsubmit="return false;">
      <div style="margin-bottom:14px;">
        <label class="gx10-admin-label" for="current-password">現在のパスワード</label>
        <div class="hpc-password-input-wrap">
          <input class="gx10-admin-input" id="current-password" type="password" required autocomplete="current-password">
          <button type="button" class="hpc-password-toggle" data-password-toggle="current-password" data-password-label="現在のパスワード" aria-label="現在のパスワードを表示" aria-pressed="false" title="現在のパスワードを表示">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.3 12s3.5-6 9.7-6 9.7 6 9.7 6-3.5 6-9.7 6-9.7-6-9.7-6Z"></path><circle cx="12" cy="12" r="2.8"></circle></svg>
          </button>
        </div>
      </div>
      <div style="margin-bottom:14px;">
        <label class="gx10-admin-label" for="new-password">新しいパスワード（8文字以上）</label>
        <div class="hpc-password-input-wrap">
          <input class="gx10-admin-input" id="new-password" type="password" minlength="8" required autocomplete="new-password">
          <button type="button" class="hpc-password-toggle" data-password-toggle="new-password" data-password-label="新しいパスワード" aria-label="新しいパスワードを表示" aria-pressed="false" title="新しいパスワードを表示">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.3 12s3.5-6 9.7-6 9.7 6 9.7 6-3.5 6-9.7 6-9.7-6-9.7-6Z"></path><circle cx="12" cy="12" r="2.8"></circle></svg>
          </button>
        </div>
      </div>
      <div style="margin-bottom:16px;">
        <label class="gx10-admin-label" for="confirm-password">新しいパスワード（確認）</label>
        <div class="hpc-password-input-wrap">
          <input class="gx10-admin-input" id="confirm-password" type="password" minlength="8" required autocomplete="new-password">
          <button type="button" class="hpc-password-toggle" data-password-toggle="confirm-password" data-password-label="新しいパスワード（確認）" aria-label="新しいパスワード（確認）を表示" aria-pressed="false" title="新しいパスワード（確認）を表示">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.3 12s3.5-6 9.7-6 9.7 6 9.7 6-3.5 6-9.7 6-9.7-6-9.7-6Z"></path><circle cx="12" cy="12" r="2.8"></circle></svg>
          </button>
        </div>
      </div>
      <button type="submit" class="gx10-admin-btn gx10-admin-btn-primary" id="password-submit">変更する</button>
    </form>
    <div id="password-msg" class="gx10-admin-msg" aria-live="polite"></div>
  </div>
</div>
{% endblock %}

{% block script %}
<script src="/hub/hpc-js/core.js?v={{ hpc_static_versions['js/core.js'] }}"></script>
<script src="/hub/hpc-js/password.js?v={{ hpc_static_versions['js/password.js'] }}"></script>
{% endblock %}
{% endraw %}
