#!/bin/bash
set -euo pipefail

JOB_NAME="{{ ollama_slurm_job_name }}"
SERVICE_USER="{{ ollama_service_user }}"
SBATCH_SCRIPT="/opt/hpc-portal/ollama/shared-ollama.sbatch"
OLLAMA_URL="http://{{ ollama_host }}:{{ ollama_port }}"
BOOTSTRAP_VERSION="{{ ollama_version }}"
IMAGE_DIR="{{ ollama_apptainer_image_dir }}"
OLLAMA_IMAGE="{{ ollama_apptainer_image }}"
RELEASE_API_URL="{{ ollama_release_api_url }}"
UPDATE_CACHE_SECONDS="{{ ollama_update_cache_seconds }}"
UPDATE_MIN_FREE_MB="{{ ollama_update_min_free_mb }}"
UPDATE_START_TIMEOUT="{{ ollama_update_start_timeout_seconds }}"
OLLAMA_MODELS_DIR="{{ ollama_models_dir }}"
DEFAULT_CPUS="{{ ollama_slurm_default_cpus }}"
DEFAULT_MEMORY="{{ ollama_slurm_default_memory }}"
GPUS="{{ ollama_slurm_gpus | default(1) }}"
ALLOWED_CPUS="{{ ollama_slurm_allowed_cpus | default([4, 8, 12, 16, 20]) | join(' ') }}"
ALLOWED_MEMORY="{{ ollama_slurm_allowed_memory | default(['16G', '32G', '64G', '96G', '112G']) | join(' ') }}"
DEFAULT_PARALLEL="{{ ollama_default_parallel | default(2) }}"
ALLOWED_PARALLEL="{{ ollama_allowed_parallel | default([1, 2, 4]) | join(' ') }}"
DEFAULT_MAX_LOADED_MODELS="{{ ollama_default_max_loaded_models | default(2) }}"
ALLOWED_MAX_LOADED_MODELS="{{ ollama_allowed_max_loaded_models | default([1, 2, 3]) | join(' ') }}"
DEFAULT_CONTEXT_LENGTH="{{ ollama_default_context_length | default(131072) }}"
ALLOWED_CONTEXT_LENGTHS="{{ ollama_allowed_context_lengths | default([32768, 65536, 131072, 262144]) | join(' ') }}"
DEFAULT_KV_CACHE_TYPE="{{ ollama_default_kv_cache_type | default('q8_0') }}"
ALLOWED_KV_CACHE_TYPES="{{ ollama_allowed_kv_cache_types | default(['f16', 'q8_0', 'q4_0']) | join(' ') }}"
DEFAULT_KEEP_ALIVE="{{ ollama_default_keep_alive | default('30m') }}"
ALLOWED_KEEP_ALIVE="{{ ollama_allowed_keep_alive | default(['5m', '30m', '1h', '-1']) | join(' ') }}"
DEFAULT_MAX_QUEUE="{{ ollama_default_max_queue | default(64) }}"
ALLOWED_MAX_QUEUE="{{ ollama_allowed_max_queue | default([32, 64, 128, 256]) | join(' ') }}"
DEFAULT_FLASH_ATTENTION="{{ '1' if ollama_default_flash_attention | default(true) | bool else '0' }}"
PULL_STATE_DIR="/run/hpc-ollama"
START_STATE_FILE="$PULL_STATE_DIR/start-settings"
PULL_LOCK_DIR="$PULL_STATE_DIR/pull.lock"
PULL_PID_FILE="$PULL_STATE_DIR/pull.pid"
PULL_MODEL_FILE="$PULL_STATE_DIR/pull.model"
PULL_LAST_MODEL_FILE="$PULL_STATE_DIR/pull.last-model"
UPDATE_STATE_DIR="$PULL_STATE_DIR/update"
UPDATE_LOCK_DIR="$PULL_STATE_DIR/update.lock"
UPDATE_PID_FILE="$UPDATE_STATE_DIR/pid"
LATEST_VERSION_FILE="{{ ollama_service_home }}/latest-version"
LATEST_CHECKED_AT_FILE="{{ ollama_service_home }}/latest-version.checked-at"

cmd="${1:-}"
model="${2:-}"

running_job_ids() {
  squeue -h -u "$SERVICE_USER" -n "$JOB_NAME" -o '%A' || true
}

contains_word() {
  value="$1"
  shift
  for candidate in "$@"; do
    if [ "$value" = "$candidate" ]; then
      return 0
    fi
  done
  return 1
}

json_escape() {
  printf '%s' "$1" | tr '\r\n' '  ' | sed 's/\\/\\\\/g; s/"/\\"/g'
}

valid_version() {
  printf '%s' "$1" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'
}

version_is_newer() {
  current="${1#v}"
  candidate="${2#v}"
  [ "$current" != "$candidate" ] &&
    [ "$(printf '%s\n%s\n' "$current" "$candidate" | sort -V | tail -n 1)" = "$candidate" ]
}

running_version() {
  response="$(curl -fsS --max-time 3 "$OLLAMA_URL/api/version" 2>/dev/null || true)"
  printf '%s' "$response" | sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p'
}

image_version() {
  image="$1"
  apptainer exec --env OLLAMA_HOST=127.0.0.1:1 "$image" ollama --version 2>/dev/null |
    sed -n -E 's/.*(client|ollama) version (is )?v?([0-9]+\.[0-9]+\.[0-9]+).*/\3/p' |
    head -n 1
}

write_update_state() {
  state="$1"
  target="${2:-}"
  message="${3:-}"
  error="${4:-}"
  mkdir -p "$UPDATE_STATE_DIR"
  state_tmp="$UPDATE_STATE_DIR/state.tmp.$$"
  (
    umask 077
    {
      printf 'STATE=%s\n' "$state"
      printf 'TARGET_VERSION=%s\n' "$target"
      printf 'MESSAGE=%s\n' "$(printf '%s' "$message" | tr '\r\n' '  ')"
      printf 'ERROR=%s\n' "$(printf '%s' "$error" | tr '\r\n' '  ')"
    } >"$state_tmp"
  )
  mv -f "$state_tmp" "$UPDATE_STATE_DIR/state"
}

update_state_value() {
  key="$1"
  sed -n "s/^${key}=//p" "$UPDATE_STATE_DIR/state" 2>/dev/null | head -n 1 || true
}

refresh_update_worker_state() {
  current_state="$(update_state_value STATE)"
  case "$current_state" in
    queued|downloading|validating|stopping|starting|waiting_api|rolling_back)
      pid="$(cat "$UPDATE_PID_FILE" 2>/dev/null || true)"
      if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
        target="$(update_state_value TARGET_VERSION)"
        write_update_state failed "$target" "更新に失敗しました" "更新処理が予期せず終了しました"
        rm -f "$UPDATE_PID_FILE"
        rmdir "$UPDATE_LOCK_DIR" 2>/dev/null || true
      fi
      ;;
  esac
}

latest_version() {
  now="$(date +%s)"
  cached="$(cat "$LATEST_VERSION_FILE" 2>/dev/null || true)"
  checked_at="$(cat "$LATEST_CHECKED_AT_FILE" 2>/dev/null || true)"
  if valid_version "$cached" && printf '%s' "$checked_at" | grep -Eq '^[0-9]+$' &&
      [ $((now - checked_at)) -lt "$UPDATE_CACHE_SECONDS" ]; then
    printf '%s' "$cached"
    return 0
  fi
  release_json="$(curl -fsS --max-time 15 \
    -H 'Accept: application/vnd.github+json' \
    -H 'User-Agent: hpc-portal-ollama-updater' \
    "$RELEASE_API_URL")" || return 1
  latest="$(printf '%s' "$release_json" | python3 -c 'import json, sys; print(str(json.load(sys.stdin).get("tag_name", "")).removeprefix("v"))' 2>/dev/null)"
  valid_version "$latest" || return 1
  umask 022
  printf '%s\n' "$latest" >"${LATEST_VERSION_FILE}.tmp"
  mv -f "${LATEST_VERSION_FILE}.tmp" "$LATEST_VERSION_FILE"
  printf '%s\n' "$now" >"${LATEST_CHECKED_AT_FILE}.tmp"
  mv -f "${LATEST_CHECKED_AT_FILE}.tmp" "$LATEST_CHECKED_AT_FILE"
  printf '%s' "$latest"
}

update_json_fields() {
  refresh_update_worker_state
  latest="$(cat "$LATEST_VERSION_FILE" 2>/dev/null || true)"
  state="$(update_state_value STATE)"
  target="$(update_state_value TARGET_VERSION)"
  message="$(update_state_value MESSAGE)"
  error="$(update_state_value ERROR)"
  printf ',"latest_version":"%s","update_state":"%s","update_target_version":"%s","update_message":"%s","update_error":"%s"' \
    "$(json_escape "$latest")" "$(json_escape "$state")" "$(json_escape "$target")" \
    "$(json_escape "$message")" "$(json_escape "$error")"
}

parse_start_args() {
  cpus="$DEFAULT_CPUS"
  memory="$DEFAULT_MEMORY"
  parallel="$DEFAULT_PARALLEL"
  max_loaded_models="$DEFAULT_MAX_LOADED_MODELS"
  context_length="$DEFAULT_CONTEXT_LENGTH"
  kv_cache_type="$DEFAULT_KV_CACHE_TYPE"
  keep_alive="$DEFAULT_KEEP_ALIVE"
  max_queue="$DEFAULT_MAX_QUEUE"
  flash_attention="$DEFAULT_FLASH_ATTENTION"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --cpus)
        cpus="${2:-}"
        shift 2
        ;;
      --memory)
        memory="${2:-}"
        shift 2
        ;;
      --parallel)
        parallel="${2:-}"
        shift 2
        ;;
      --max-loaded-models)
        max_loaded_models="${2:-}"
        shift 2
        ;;
      --context-length)
        context_length="${2:-}"
        shift 2
        ;;
      --kv-cache-type)
        kv_cache_type="${2:-}"
        shift 2
        ;;
      --keep-alive)
        keep_alive="${2:-}"
        shift 2
        ;;
      --max-queue)
        max_queue="${2:-}"
        shift 2
        ;;
      --flash-attention)
        flash_attention="${2:-}"
        shift 2
        ;;
      *)
        echo "unknown start option: $1" >&2
        exit 2
        ;;
    esac
  done
  # shellcheck disable=SC2086
  if ! contains_word "$cpus" $ALLOWED_CPUS; then
    echo "invalid cpus: $cpus" >&2
    exit 2
  fi
  # shellcheck disable=SC2086
  if ! contains_word "$memory" $ALLOWED_MEMORY; then
    echo "invalid memory: $memory" >&2
    exit 2
  fi
  # shellcheck disable=SC2086
  contains_word "$parallel" $ALLOWED_PARALLEL || { echo "invalid parallel: $parallel" >&2; exit 2; }
  # shellcheck disable=SC2086
  contains_word "$max_loaded_models" $ALLOWED_MAX_LOADED_MODELS || { echo "invalid max loaded models: $max_loaded_models" >&2; exit 2; }
  # shellcheck disable=SC2086
  contains_word "$context_length" $ALLOWED_CONTEXT_LENGTHS || { echo "invalid context length: $context_length" >&2; exit 2; }
  # shellcheck disable=SC2086
  contains_word "$kv_cache_type" $ALLOWED_KV_CACHE_TYPES || { echo "invalid KV cache type: $kv_cache_type" >&2; exit 2; }
  # shellcheck disable=SC2086
  contains_word "$keep_alive" $ALLOWED_KEEP_ALIVE || { echo "invalid keep alive: $keep_alive" >&2; exit 2; }
  # shellcheck disable=SC2086
  contains_word "$max_queue" $ALLOWED_MAX_QUEUE || { echo "invalid max queue: $max_queue" >&2; exit 2; }
  contains_word "$flash_attention" 0 1 || { echo "invalid Flash Attention: $flash_attention" >&2; exit 2; }
}

state_value() {
  key="$1"
  fallback="$2"
  value="$(sed -n "s/^${key}=//p" "$START_STATE_FILE" 2>/dev/null | head -n 1 || true)"
  printf '%s' "${value:-$fallback}"
}

cleanup_partial_download() {
  pull_log="$1"
  blobs_dir="$OLLAMA_MODELS_DIR/blobs"
  [ -d "$blobs_dir" ] || return 0
  digests="$(sed -n -E 's/.*"digest"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/p' "$pull_log" 2>/dev/null | sort -u || true)"
  for digest in $digests; do
    digest="${digest#sha256:}"
    if ! printf '%s' "$digest" | grep -Eq '^[0-9a-f]{64}$'; then
      continue
    fi
    find "$blobs_dir" -maxdepth 1 -type f -name "sha256-${digest}-partial*" -delete || return 1
    if find "$blobs_dir" -maxdepth 1 -type f -name "sha256-${digest}-partial*" -print -quit | grep -q .; then
      return 1
    fi
  done
}

case "$cmd" in
  _pull-worker)
    if [ -z "$model" ]; then
      exit 2
    fi
    safe_model="$(printf '%s' "$model" | tr '/:' '__')"
    log="/var/log/hpc-ollama/pull-${safe_model}.log"
    printf '%s' "$BASHPID" >"$PULL_PID_FILE"
    printf '%s' "$model" >"$PULL_MODEL_FILE"
    set +e
    sudo -u "$SERVICE_USER" curl -fsSN "$OLLAMA_URL/api/pull" \
      -H 'Content-Type: application/json' \
      -d "{\"name\":\"$model\"}" >"$log" 2>&1
    rc=$?
    printf '%s' "$rc" >"$PULL_STATE_DIR/pull-${safe_model}.result"
    rm -f "$PULL_PID_FILE" "$PULL_MODEL_FILE"
    rmdir "$PULL_LOCK_DIR" 2>/dev/null || true
    exit "$rc"
    ;;
  _update-worker)
    target="${model#v}"
    if ! valid_version "$target"; then
      write_update_state failed "" "更新に失敗しました" "更新対象のバージョンが不正です"
      rmdir "$UPDATE_LOCK_DIR" 2>/dev/null || true
      exit 2
    fi
    printf '%s' "$BASHPID" >"$UPDATE_PID_FILE"
    log="/var/log/hpc-ollama/update-${target}.log"
    new_image="$IMAGE_DIR/ollama-${target}.sif"
    temporary_image="${new_image}.new.$$"
    update_tmp_dir=""
    next_link=""
    rollback_link=""
    old_image="$(readlink -f "$OLLAMA_IMAGE" 2>/dev/null || true)"
    old_version="$(running_version)"
    cleanup_update_worker() {
      rc=$?
      final_state="$(update_state_value STATE)"
      case "$final_state" in
        completed|failed|rolled_back|rollback_failed) ;;
        *)
          if [ "$rc" -ne 0 ]; then
            write_update_state failed "$target" "更新に失敗しました" "更新処理が予期せず終了しました。ログ: $log"
          fi
          ;;
      esac
      rm -f "$temporary_image" "$UPDATE_PID_FILE"
      [ -z "$update_tmp_dir" ] || rm -rf -- "$update_tmp_dir"
      [ -z "$next_link" ] || rm -f "$next_link"
      [ -z "$rollback_link" ] || rm -f "$rollback_link"
      rmdir "$UPDATE_LOCK_DIR" 2>/dev/null || true
    }
    trap cleanup_update_worker EXIT

    ids="$(running_job_ids)"
    first_id="$(printf '%s\n' "$ids" | head -n 1)"
    job_info="$(squeue -h -j "$first_id" -o '%C|%m' 2>/dev/null | head -n 1 || true)"
    cpus="$(printf '%s' "$job_info" | awk -F'|' '{print $1}')"
    memory="$(printf '%s' "$job_info" | awk -F'|' '{print $2}')"
    cpus="${cpus:-$DEFAULT_CPUS}"
    memory="${memory:-$DEFAULT_MEMORY}"
    parallel="$(state_value PARALLEL "$DEFAULT_PARALLEL")"
    max_loaded_models="$(state_value MAX_LOADED_MODELS "$DEFAULT_MAX_LOADED_MODELS")"
    context_length="$(state_value CONTEXT_LENGTH "$DEFAULT_CONTEXT_LENGTH")"
    kv_cache_type="$(state_value KV_CACHE_TYPE "$DEFAULT_KV_CACHE_TYPE")"
    keep_alive="$(state_value KEEP_ALIVE "$DEFAULT_KEEP_ALIVE")"
    max_queue="$(state_value MAX_QUEUE "$DEFAULT_MAX_QUEUE")"
    flash_attention="$(state_value FLASH_ATTENTION "$DEFAULT_FLASH_ATTENTION")"

    if [ -z "$old_image" ] || [ ! -f "$old_image" ]; then
      write_update_state failed "$target" "更新に失敗しました" "現在使用中のOllamaイメージを確認できません"
      exit 1
    fi
    if [ -z "$old_version" ]; then
      write_update_state failed "$target" "更新に失敗しました" "現在実行中のOllamaバージョンを確認できません"
      exit 1
    fi

    if [ ! -f "$new_image" ]; then
      available_mb="$(df -Pm "$IMAGE_DIR" | awk 'NR == 2 {print $4}')"
      current_image_mb="$(du -Pm "$old_image" | awk '{print $1}')"
      required_mb="$UPDATE_MIN_FREE_MB"
      if printf '%s' "$current_image_mb" | grep -Eq '^[0-9]+$' &&
          [ $((current_image_mb * 2 + 1024)) -gt "$required_mb" ]; then
        required_mb=$((current_image_mb * 2 + 1024))
      fi
      if ! printf '%s' "$available_mb" | grep -Eq '^[0-9]+$' || [ "$available_mb" -lt "$required_mb" ]; then
        write_update_state failed "$target" "更新に失敗しました" "イメージ保存先の空き容量が不足しています（最低 ${required_mb}MB 必要）"
        exit 1
      fi
      write_update_state downloading "$target" "v${target}のイメージをダウンロードしています" ""
      update_tmp_dir="$(mktemp -d "$IMAGE_DIR/.update-tmp.XXXXXX")"
      if ! APPTAINER_TMPDIR="$update_tmp_dir" apptainer build --disable-cache --force "$temporary_image" "docker://ollama/ollama:${target}" >"$log" 2>&1; then
        write_update_state failed "$target" "更新に失敗しました" "Ollamaイメージを取得できませんでした。ログ: $log"
        exit 1
      fi
      mv -f "$temporary_image" "$new_image"
    fi
    chmod 0644 "$new_image"
    if ! sudo -u "$SERVICE_USER" test -r "$new_image"; then
      write_update_state failed "$target" "更新に失敗しました" "Ollama実行ユーザーが取得したイメージを読み取れません"
      exit 1
    fi

    write_update_state validating "$target" "ダウンロードしたイメージを検証しています" ""
    verified_version="$(image_version "$new_image")"
    if [ "$verified_version" != "$target" ]; then
      rm -f "$new_image"
      write_update_state failed "$target" "更新に失敗しました" "取得したイメージのバージョン ${verified_version:-不明} がv${target}と一致しません"
      exit 1
    fi
    write_update_state stopping "$target" "現在のOllamaを停止しています" ""
    scancel $ids
    for _attempt in $(seq 1 200); do
      [ -z "$(running_job_ids)" ] && break
      sleep 0.1
    done
    if [ -n "$(running_job_ids)" ]; then
      write_update_state failed "$target" "更新に失敗しました" "現在のOllamaを停止できませんでした"
      exit 1
    fi

    next_link="${OLLAMA_IMAGE}.next.$$"
    ln -s "$new_image" "$next_link"
    mv -Tf "$next_link" "$OLLAMA_IMAGE"
    rm -f "$START_STATE_FILE"
    write_update_state starting "$target" "v${target}のOllamaジョブを起動しています" ""
    if ! "$0" start \
      --cpus "$cpus" --memory "$memory" --parallel "$parallel" \
      --max-loaded-models "$max_loaded_models" --context-length "$context_length" \
      --kv-cache-type "$kv_cache_type" --keep-alive "$keep_alive" \
      --max-queue "$max_queue" --flash-attention "$flash_attention" >>"$log" 2>&1; then
      start_failed=true
    else
      start_failed=false
    fi

    if [ "$start_failed" = false ]; then
      write_update_state waiting_api "$target" "v${target}のAPI起動を待っています" ""
      for _attempt in $(seq 1 "$UPDATE_START_TIMEOUT"); do
        detected="$(running_version)"
        if [ "${detected#v}" = "$target" ]; then
          write_update_state completed "$target" "v${target}への更新が完了しました" ""
          for image in "$IMAGE_DIR"/ollama-*.sif; do
            [ -e "$image" ] || continue
            if [ "$image" != "$new_image" ] && [ "$image" != "$old_image" ]; then
              rm -f -- "$image"
            fi
          done
          exit 0
        fi
        sleep 1
      done
    fi

    write_update_state rolling_back "$target" "新バージョンを起動できないため直前のバージョンへ戻しています" ""
    rollback_ids="$(running_job_ids)"
    [ -z "$rollback_ids" ] || scancel $rollback_ids
    for _attempt in $(seq 1 200); do
      [ -z "$(running_job_ids)" ] && break
      sleep 0.1
    done
    rollback_link="${OLLAMA_IMAGE}.rollback.$$"
    ln -s "$old_image" "$rollback_link"
    mv -Tf "$rollback_link" "$OLLAMA_IMAGE"
    rm -f "$START_STATE_FILE"
    if "$0" start \
      --cpus "$cpus" --memory "$memory" --parallel "$parallel" \
      --max-loaded-models "$max_loaded_models" --context-length "$context_length" \
      --kv-cache-type "$kv_cache_type" --keep-alive "$keep_alive" \
      --max-queue "$max_queue" --flash-attention "$flash_attention" >>"$log" 2>&1; then
      for _attempt in $(seq 1 "$UPDATE_START_TIMEOUT"); do
        detected="$(running_version)"
        if [ "${detected#v}" = "${old_version#v}" ]; then
          rm -f "$new_image"
          write_update_state rolled_back "$target" "更新に失敗し、直前のバージョンへ復旧しました" "新バージョンのAPIを起動できませんでした"
          exit 1
        fi
        sleep 1
      done
    fi
    write_update_state rollback_failed "$target" "更新と自動復旧に失敗しました" "管理者がログを確認してください: $log"
    exit 1
    ;;
  start)
    shift || true
    parse_start_args "$@"
    ids="$(running_job_ids)"
    if [ -n "$ids" ]; then
      ids_csv="$(printf '%s' "$ids" | tr '\n' ',' | sed 's/,$//')"
      printf '{"status":"already_running","job_ids":"%s"}\n' "$(json_escape "$ids_csv")"
      exit 0
    fi
    mkdir -p "$PULL_STATE_DIR"
    sbatch_output="$(sudo -u "$SERVICE_USER" sbatch \
      --parsable \
      --cpus-per-task="$cpus" \
      --mem="$memory" \
      --gres="gpu:$GPUS" \
      --export="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin,OLLAMA_NUM_PARALLEL=$parallel,OLLAMA_MAX_LOADED_MODELS=$max_loaded_models,OLLAMA_CONTEXT_LENGTH=$context_length,OLLAMA_KV_CACHE_TYPE=$kv_cache_type,OLLAMA_KEEP_ALIVE=$keep_alive,OLLAMA_MAX_QUEUE=$max_queue,OLLAMA_FLASH_ATTENTION=$flash_attention" \
      "$SBATCH_SCRIPT")"
    job_id="${sbatch_output%%;*}"
    state_tmp="${START_STATE_FILE}.tmp"
    umask 077
    {
      printf 'JOB_ID=%s\n' "$job_id"
      printf 'PARALLEL=%s\n' "$parallel"
      printf 'MAX_LOADED_MODELS=%s\n' "$max_loaded_models"
      printf 'CONTEXT_LENGTH=%s\n' "$context_length"
      printf 'KV_CACHE_TYPE=%s\n' "$kv_cache_type"
      printf 'KEEP_ALIVE=%s\n' "$keep_alive"
      printf 'MAX_QUEUE=%s\n' "$max_queue"
      printf 'FLASH_ATTENTION=%s\n' "$flash_attention"
    } >"$state_tmp"
    mv "$state_tmp" "$START_STATE_FILE"
    printf '{"status":"started","job_ids":"%s"}\n' "$(json_escape "$job_id")"
    ;;
  stop)
    if [ -d "$UPDATE_LOCK_DIR" ]; then
      echo "Ollamaの更新中は停止できません" >&2
      exit 1
    fi
    ids="$(running_job_ids)"
    if [ -z "$ids" ]; then
      echo "shared ollama is not running"
      exit 0
    fi
    scancel $ids
    rm -f "$START_STATE_FILE"
    printf '{"status":"stopped"}\n'
    ;;
  update-check)
    if ! latest="$(latest_version)"; then
      echo "Ollamaの最新安定版を確認できませんでした" >&2
      exit 1
    fi
    current="$(running_version)"
    available=false
    if [ -n "$current" ] && version_is_newer "$current" "$latest"; then
      available=true
    fi
    printf '{"latest_version":"%s","running_version":"%s","update_available":%s}\n' \
      "$(json_escape "$latest")" "$(json_escape "$current")" "$available"
    ;;
  update)
    ids="$(running_job_ids)"
    if [ -z "$ids" ]; then
      echo "共有Ollamaは起動していません" >&2
      exit 1
    fi
    if [ -f "$PULL_PID_FILE" ] && kill -0 "$(cat "$PULL_PID_FILE")" 2>/dev/null; then
      echo "モデルのダウンロード中はOllamaを更新できません" >&2
      exit 1
    fi
    current="$(running_version)"
    if [ -z "$current" ]; then
      echo "稼働中のOllamaバージョンを確認できません" >&2
      exit 1
    fi
    if ! latest="$(latest_version)"; then
      echo "Ollamaの最新安定版を確認できませんでした" >&2
      exit 1
    fi
    if ! version_is_newer "$current" "$latest"; then
      printf '{"status":"already_current","version":"%s","latest_version":"%s"}\n' \
        "$(json_escape "${current#v}")" "$(json_escape "$latest")"
      exit 0
    fi
    if [ -d "$UPDATE_LOCK_DIR" ]; then
      update_pid="$(cat "$UPDATE_PID_FILE" 2>/dev/null || true)"
      if [ -n "$update_pid" ] && kill -0 "$update_pid" 2>/dev/null; then
        echo "Ollamaの更新はすでに実行中です" >&2
        exit 1
      fi
      rm -f "$UPDATE_PID_FILE"
      rmdir "$UPDATE_LOCK_DIR" 2>/dev/null || true
    fi
    if ! mkdir "$UPDATE_LOCK_DIR" 2>/dev/null; then
      echo "Ollamaの更新はすでに実行中です" >&2
      exit 1
    fi
    write_update_state queued "$latest" "v${latest}への更新を準備しています" ""
    setsid "$0" _update-worker "$latest" </dev/null >/dev/null 2>&1 &
    worker_pid=$!
    printf '%s' "$worker_pid" >"$UPDATE_PID_FILE"
    for _attempt in $(seq 1 20); do
      [ -f "$UPDATE_PID_FILE" ] || { kill -0 "$worker_pid" 2>/dev/null && sleep 0.05 || break; }
    done
    if [ ! -f "$UPDATE_PID_FILE" ]; then
      rmdir "$UPDATE_LOCK_DIR" 2>/dev/null || true
      echo "Ollama更新処理を開始できませんでした" >&2
      exit 1
    fi
    printf '{"status":"started","target_version":"%s"}\n' "$(json_escape "$latest")"
    ;;
  status)
    ids="$(running_job_ids)"
    if [ -z "$ids" ]; then
      rm -f "$START_STATE_FILE"
      printf '{"running":false,"api":false,"version":"","bootstrap_version":"%s"%s}\n' \
        "$(json_escape "$BOOTSTRAP_VERSION")" "$(update_json_fields)"
      exit 0
    fi
    ids_csv="$(printf '%s' "$ids" | tr '\n' ',' | sed 's/,$//')"
    first_id="$(printf '%s\n' "$ids" | head -n 1)"
    state_job_id="$(state_value JOB_ID '')"
    if [ "$state_job_id" != "$first_id" ]; then
      rm -f "$START_STATE_FILE"
    fi
    job_parallel="$(state_value PARALLEL '')"
    job_max_loaded_models="$(state_value MAX_LOADED_MODELS '')"
    job_context_length="$(state_value CONTEXT_LENGTH '')"
    job_kv_cache_type="$(state_value KV_CACHE_TYPE '')"
    job_keep_alive="$(state_value KEEP_ALIVE '')"
    job_max_queue="$(state_value MAX_QUEUE '')"
    job_flash_attention="$(state_value FLASH_ATTENTION '')"
    job_info="$(squeue -h -j "$first_id" -o '%C|%m|%b' 2>/dev/null | head -n 1 || true)"
    job_cpus="$(printf '%s' "$job_info" | awk -F'|' '{print $1}')"
    job_memory="$(printf '%s' "$job_info" | awk -F'|' '{print $2}')"
    job_gres="$(printf '%s' "$job_info" | awk -F'|' '{print $3}')"
    if printf '%s' "$job_gres" | grep -q 'gpu'; then
      job_gpus="$GPUS"
    else
      job_gpus="$GPUS"
    fi
    if version_response="$(curl -fsS "$OLLAMA_URL/api/version" 2>/dev/null)"; then
      running_version="$(printf '%s' "$version_response" | sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
      printf '{"running":true,"api":true,"job_ids":"%s","cpus":"%s","memory":"%s","gpus":"%s","version":"%s","bootstrap_version":"%s","parallel":"%s","max_loaded_models":"%s","context_length":"%s","kv_cache_type":"%s","keep_alive":"%s","max_queue":"%s","flash_attention":"%s"%s}\n' "$(json_escape "$ids_csv")" "$(json_escape "$job_cpus")" "$(json_escape "$job_memory")" "$(json_escape "$job_gpus")" "$(json_escape "$running_version")" "$(json_escape "$BOOTSTRAP_VERSION")" "$(json_escape "$job_parallel")" "$(json_escape "$job_max_loaded_models")" "$(json_escape "$job_context_length")" "$(json_escape "$job_kv_cache_type")" "$(json_escape "$job_keep_alive")" "$(json_escape "$job_max_queue")" "$(json_escape "$job_flash_attention")" "$(update_json_fields)"
    else
      printf '{"running":true,"api":false,"job_ids":"%s","cpus":"%s","memory":"%s","gpus":"%s","version":"","bootstrap_version":"%s","parallel":"%s","max_loaded_models":"%s","context_length":"%s","kv_cache_type":"%s","keep_alive":"%s","max_queue":"%s","flash_attention":"%s"%s}\n' "$(json_escape "$ids_csv")" "$(json_escape "$job_cpus")" "$(json_escape "$job_memory")" "$(json_escape "$job_gpus")" "$(json_escape "$BOOTSTRAP_VERSION")" "$(json_escape "$job_parallel")" "$(json_escape "$job_max_loaded_models")" "$(json_escape "$job_context_length")" "$(json_escape "$job_kv_cache_type")" "$(json_escape "$job_keep_alive")" "$(json_escape "$job_max_queue")" "$(json_escape "$job_flash_attention")" "$(update_json_fields)"
    fi
    ;;
  tags)
    exec curl -fsS "$OLLAMA_URL/api/tags"
    ;;
  show)
    if [ -z "$model" ]; then
      echo "model required" >&2
      exit 2
    fi
    exec curl -fsS "$OLLAMA_URL/api/show" \
      -H 'Content-Type: application/json' \
      -d "{\"model\":\"$model\"}"
    ;;
  ps)
    exec curl -fsS "$OLLAMA_URL/api/ps"
    ;;
  pull)
    if [ -z "$model" ]; then
      echo "model required" >&2
      exit 2
    fi
    if [ -d "$UPDATE_LOCK_DIR" ]; then
      echo "Ollamaの更新中はモデルをダウンロードできません" >&2
      exit 1
    fi
    safe_model="$(printf '%s' "$model" | tr '/:' '__')"
    log="/var/log/hpc-ollama/pull-${safe_model}.log"
    mkdir -p "$PULL_STATE_DIR"
    if [ -f "$PULL_PID_FILE" ] && ! kill -0 "$(cat "$PULL_PID_FILE")" 2>/dev/null; then
      rm -f "$PULL_PID_FILE" "$PULL_MODEL_FILE"
      rmdir "$PULL_LOCK_DIR" 2>/dev/null || true
    fi
    if ! mkdir "$PULL_LOCK_DIR" 2>/dev/null; then
      active_model="$(cat "$PULL_MODEL_FILE" 2>/dev/null || true)"
      echo "another model pull is already running: ${active_model:-unknown}" >&2
      exit 1
    fi
    printf '%s' "$model" >"$PULL_LAST_MODEL_FILE"
    rm -f "$log" "$PULL_STATE_DIR/pull-${safe_model}.result"
    # Pull専用のプロセスグループに分離し、中止時にOllama本体を止めず通信だけ終了する。
    setsid "$0" _pull-worker "$model" </dev/null >/dev/null 2>&1 &
    worker_pid=$!
    for _attempt in $(seq 1 20); do
      if [ -f "$PULL_PID_FILE" ] || ! kill -0 "$worker_pid" 2>/dev/null; then
        break
      fi
      sleep 0.05
    done
    if [ ! -f "$PULL_PID_FILE" ]; then
      result="$(cat "$PULL_STATE_DIR/pull-${safe_model}.result" 2>/dev/null || true)"
      if [ "$result" != "0" ]; then
        if kill -0 "$worker_pid" 2>/dev/null; then
          kill -TERM -- "-$worker_pid" 2>/dev/null || true
        fi
        wait "$worker_pid" 2>/dev/null || true
        rmdir "$PULL_LOCK_DIR" 2>/dev/null || true
        echo "pull worker failed to start" >&2
        exit 1
      fi
    fi
    echo "{\"status\":\"pulling\",\"model\":\"$(json_escape "$model")\"}"
    ;;
  pull-cancel)
    if [ -z "$model" ]; then
      echo "model required" >&2
      exit 2
    fi
    safe_model="$(printf '%s' "$model" | tr '/:' '__')"
    log="/var/log/hpc-ollama/pull-${safe_model}.log"
    result_file="$PULL_STATE_DIR/pull-${safe_model}.result"
    active_model="$(cat "$PULL_MODEL_FILE" 2>/dev/null || true)"
    pid="$(cat "$PULL_PID_FILE" 2>/dev/null || true)"
    result="$(cat "$result_file" 2>/dev/null || true)"
    if [ -n "$active_model" ] && [ "$active_model" != "$model" ]; then
      echo "another model pull is running: $active_model" >&2
      exit 1
    fi
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      worker_command=""
      if [ -r "/proc/$pid/cmdline" ]; then
        worker_command="$(tr '\0' ' ' <"/proc/$pid/cmdline")"
      fi
      case "$worker_command" in
        *" _pull-worker $model"*) ;;
        *)
          echo "pull worker verification failed" >&2
          exit 1
          ;;
      esac
      kill -TERM -- "-$pid" 2>/dev/null || true
      for _attempt in $(seq 1 50); do
        if ! kill -0 -- "-$pid" 2>/dev/null; then
          break
        fi
        sleep 0.1
      done
      if kill -0 -- "-$pid" 2>/dev/null; then
        kill -KILL -- "-$pid" 2>/dev/null || true
        for _attempt in $(seq 1 20); do
          if ! kill -0 -- "-$pid" 2>/dev/null; then
            break
          fi
          sleep 0.1
        done
      fi
      if kill -0 -- "-$pid" 2>/dev/null; then
        echo "pull worker did not stop" >&2
        exit 1
      fi
    elif [ "$result" != "cancelled_cleanup_failed" ]; then
      if [ "$result" = "0" ]; then
        printf '{"status":"already_completed","model":"%s"}\n' "$(json_escape "$model")"
        exit 0
      fi
      echo "model pull is not running" >&2
      exit 1
    fi
    result="$(cat "$result_file" 2>/dev/null || true)"
    if [ "$result" = "0" ]; then
      rm -f "$PULL_PID_FILE" "$PULL_MODEL_FILE"
      rmdir "$PULL_LOCK_DIR" 2>/dev/null || true
      printf '{"status":"already_completed","model":"%s"}\n' "$(json_escape "$model")"
      exit 0
    fi
    sleep 1
    cleanup_ok=true
    if ! cleanup_partial_download "$log"; then
      cleanup_ok=false
    fi
    sleep 0.3
    if ! cleanup_partial_download "$log"; then
      cleanup_ok=false
    fi
    if [ "$cleanup_ok" = true ]; then
      printf 'cancelled' >"$result_file"
      rm -f "$PULL_PID_FILE" "$PULL_MODEL_FILE"
      rmdir "$PULL_LOCK_DIR" 2>/dev/null || true
      printf '{"status":"cancelled","model":"%s"}\n' "$(json_escape "$model")"
      exit 0
    fi
    printf 'cancelled_cleanup_failed' >"$result_file"
    rm -f "$PULL_PID_FILE" "$PULL_MODEL_FILE"
    rmdir "$PULL_LOCK_DIR" 2>/dev/null || true
    echo "ダウンロードは中止しましたが、途中データを削除できませんでした" >&2
    exit 1
    ;;
  pull-status)
    active=false
    active_model="$(cat "$PULL_MODEL_FILE" 2>/dev/null || true)"
    last_model="$(cat "$PULL_LAST_MODEL_FILE" 2>/dev/null || true)"
    if [ -f "$PULL_PID_FILE" ] && kill -0 "$(cat "$PULL_PID_FILE")" 2>/dev/null; then
      active=true
    fi
    status_model="${model:-${active_model:-$last_model}}"
    safe_model="$(printf '%s' "$status_model" | tr '/:' '__')"
    last=""
    result=""
    if [ -n "$status_model" ]; then
      last="$(tail -n 1 "/var/log/hpc-ollama/pull-${safe_model}.log" 2>/dev/null || true)"
      result="$(cat "$PULL_STATE_DIR/pull-${safe_model}.result" 2>/dev/null || true)"
    fi
    printf '{"active":%s,"active_model":"%s","model":"%s","result":"%s","last":"%s"}\n' \
      "$active" "$(json_escape "$active_model")" "$(json_escape "$status_model")" "$(json_escape "$result")" "$(json_escape "$last")"
    ;;
  delete)
    if [ -z "$model" ]; then
      echo "model required" >&2
      exit 2
    fi
    sudo -u "$SERVICE_USER" curl -fsS -X DELETE "$OLLAMA_URL/api/delete" \
      -H 'Content-Type: application/json' \
      -d "{\"name\":\"$model\"}"
    if [ "$(cat "$PULL_LAST_MODEL_FILE" 2>/dev/null || true)" = "$model" ]; then
      safe_model="$(printf '%s' "$model" | tr '/:' '__')"
      rm -f "$PULL_LAST_MODEL_FILE" "$PULL_STATE_DIR/pull-${safe_model}.result"
    fi
    ;;
  *)
    echo "usage: hpc-ollama start|stop|update-check|update|status|tags|show <model>|ps|pull <model>|pull-cancel <model>|pull-status [model]|delete <model>" >&2
    exit 2
    ;;
esac
