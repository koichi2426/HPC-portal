#!/bin/bash
set -euo pipefail

JOB_NAME="{{ ollama_slurm_job_name }}"
SERVICE_USER="{{ ollama_service_user }}"
SBATCH_SCRIPT="/opt/hpc-portal/ollama/shared-ollama.sbatch"
OLLAMA_URL="http://{{ ollama_host }}:{{ ollama_port }}"
OLLAMA_MODELS_DIR="{{ ollama_models_dir }}"
DEFAULT_CPUS="{{ ollama_slurm_default_cpus }}"
DEFAULT_MEMORY="{{ ollama_slurm_default_memory }}"
GPUS="{{ ollama_slurm_gpus | default(1) }}"
ALLOWED_CPUS="{{ ollama_slurm_allowed_cpus | default([4, 8, 12, 16, 20]) | join(' ') }}"
ALLOWED_MEMORY="{{ ollama_slurm_allowed_memory | default(['16G', '32G', '64G', '96G', '112G']) | join(' ') }}"
PULL_STATE_DIR="/run/hpc-ollama"
PULL_LOCK_DIR="$PULL_STATE_DIR/pull.lock"
PULL_PID_FILE="$PULL_STATE_DIR/pull.pid"
PULL_MODEL_FILE="$PULL_STATE_DIR/pull.model"
PULL_LAST_MODEL_FILE="$PULL_STATE_DIR/pull.last-model"

cmd="${1:-}"
model="${2:-}"

running_job_ids() {
  squeue -h -u "$SERVICE_USER" -n "$JOB_NAME" -o '%A' || true
}

contains_word() {
  value="$1"
  shift
  for candidate in "$@"; do
    if [ "$value" = "$candidate" ]; then
      return 0
    fi
  done
  return 1
}

json_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

parse_start_args() {
  cpus="$DEFAULT_CPUS"
  memory="$DEFAULT_MEMORY"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --cpus)
        cpus="${2:-}"
        shift 2
        ;;
      --memory)
        memory="${2:-}"
        shift 2
        ;;
      *)
        echo "unknown start option: $1" >&2
        exit 2
        ;;
    esac
  done
  # shellcheck disable=SC2086
  if ! contains_word "$cpus" $ALLOWED_CPUS; then
    echo "invalid cpus: $cpus" >&2
    exit 2
  fi
  # shellcheck disable=SC2086
  if ! contains_word "$memory" $ALLOWED_MEMORY; then
    echo "invalid memory: $memory" >&2
    exit 2
  fi
}

cleanup_partial_download() {
  pull_log="$1"
  blobs_dir="$OLLAMA_MODELS_DIR/blobs"
  [ -d "$blobs_dir" ] || return 0
  digests="$(sed -n -E 's/.*"digest"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/p' "$pull_log" 2>/dev/null | sort -u || true)"
  for digest in $digests; do
    digest="${digest#sha256:}"
    if ! printf '%s' "$digest" | grep -Eq '^[0-9a-f]{64}$'; then
      continue
    fi
    find "$blobs_dir" -maxdepth 1 -type f -name "sha256-${digest}-partial*" -delete || return 1
    if find "$blobs_dir" -maxdepth 1 -type f -name "sha256-${digest}-partial*" -print -quit | grep -q .; then
      return 1
    fi
  done
}

case "$cmd" in
  _pull-worker)
    if [ -z "$model" ]; then
      exit 2
    fi
    safe_model="$(printf '%s' "$model" | tr '/:' '__')"
    log="/var/log/hpc-ollama/pull-${safe_model}.log"
    printf '%s' "$BASHPID" >"$PULL_PID_FILE"
    printf '%s' "$model" >"$PULL_MODEL_FILE"
    set +e
    sudo -u "$SERVICE_USER" curl -fsSN "$OLLAMA_URL/api/pull" \
      -H 'Content-Type: application/json' \
      -d "{\"name\":\"$model\"}" >"$log" 2>&1
    rc=$?
    printf '%s' "$rc" >"$PULL_STATE_DIR/pull-${safe_model}.result"
    rm -f "$PULL_PID_FILE" "$PULL_MODEL_FILE"
    rmdir "$PULL_LOCK_DIR" 2>/dev/null || true
    exit "$rc"
    ;;
  start)
    shift || true
    parse_start_args "$@"
    ids="$(running_job_ids)"
    if [ -n "$ids" ]; then
      ids_csv="$(printf '%s' "$ids" | tr '\n' ',' | sed 's/,$//')"
      printf '{"status":"already_running","job_ids":"%s"}\n' "$(json_escape "$ids_csv")"
      exit 0
    fi
    exec sudo -u "$SERVICE_USER" sbatch \
      --cpus-per-task="$cpus" \
      --mem="$memory" \
      --gres="gpu:$GPUS" \
      "$SBATCH_SCRIPT"
    ;;
  stop)
    ids="$(running_job_ids)"
    if [ -z "$ids" ]; then
      echo "shared ollama is not running"
      exit 0
    fi
    exec scancel $ids
    ;;
  status)
    ids="$(running_job_ids)"
    if [ -z "$ids" ]; then
      echo '{"running":false,"api":false}'
      exit 0
    fi
    ids_csv="$(printf '%s' "$ids" | tr '\n' ',' | sed 's/,$//')"
    first_id="$(printf '%s\n' "$ids" | head -n 1)"
    job_info="$(squeue -h -j "$first_id" -o '%C|%m|%b' 2>/dev/null | head -n 1 || true)"
    job_cpus="$(printf '%s' "$job_info" | awk -F'|' '{print $1}')"
    job_memory="$(printf '%s' "$job_info" | awk -F'|' '{print $2}')"
    job_gres="$(printf '%s' "$job_info" | awk -F'|' '{print $3}')"
    if printf '%s' "$job_gres" | grep -q 'gpu'; then
      job_gpus="$GPUS"
    else
      job_gpus="$GPUS"
    fi
    if curl -fsS "$OLLAMA_URL/api/version" >/dev/null 2>&1; then
      printf '{"running":true,"api":true,"job_ids":"%s","cpus":"%s","memory":"%s","gpus":"%s"}\n' "$(json_escape "$ids_csv")" "$(json_escape "$job_cpus")" "$(json_escape "$job_memory")" "$(json_escape "$job_gpus")"
    else
      printf '{"running":true,"api":false,"job_ids":"%s","cpus":"%s","memory":"%s","gpus":"%s"}\n' "$(json_escape "$ids_csv")" "$(json_escape "$job_cpus")" "$(json_escape "$job_memory")" "$(json_escape "$job_gpus")"
    fi
    ;;
  tags)
    exec curl -fsS "$OLLAMA_URL/api/tags"
    ;;
  ps)
    exec curl -fsS "$OLLAMA_URL/api/ps"
    ;;
  pull)
    if [ -z "$model" ]; then
      echo "model required" >&2
      exit 2
    fi
    safe_model="$(printf '%s' "$model" | tr '/:' '__')"
    log="/var/log/hpc-ollama/pull-${safe_model}.log"
    mkdir -p "$PULL_STATE_DIR"
    if [ -f "$PULL_PID_FILE" ] && ! kill -0 "$(cat "$PULL_PID_FILE")" 2>/dev/null; then
      rm -f "$PULL_PID_FILE" "$PULL_MODEL_FILE"
      rmdir "$PULL_LOCK_DIR" 2>/dev/null || true
    fi
    if ! mkdir "$PULL_LOCK_DIR" 2>/dev/null; then
      active_model="$(cat "$PULL_MODEL_FILE" 2>/dev/null || true)"
      echo "another model pull is already running: ${active_model:-unknown}" >&2
      exit 1
    fi
    printf '%s' "$model" >"$PULL_LAST_MODEL_FILE"
    rm -f "$log" "$PULL_STATE_DIR/pull-${safe_model}.result"
    # Pull専用のプロセスグループに分離し、中止時にOllama本体を止めず通信だけ終了する。
    setsid "$0" _pull-worker "$model" </dev/null >/dev/null 2>&1 &
    worker_pid=$!
    for _attempt in $(seq 1 20); do
      if [ -f "$PULL_PID_FILE" ] || ! kill -0 "$worker_pid" 2>/dev/null; then
        break
      fi
      sleep 0.05
    done
    if [ ! -f "$PULL_PID_FILE" ]; then
      result="$(cat "$PULL_STATE_DIR/pull-${safe_model}.result" 2>/dev/null || true)"
      if [ "$result" != "0" ]; then
        if kill -0 "$worker_pid" 2>/dev/null; then
          kill -TERM -- "-$worker_pid" 2>/dev/null || true
        fi
        wait "$worker_pid" 2>/dev/null || true
        rmdir "$PULL_LOCK_DIR" 2>/dev/null || true
        echo "pull worker failed to start" >&2
        exit 1
      fi
    fi
    echo "{\"status\":\"pulling\",\"model\":\"$(json_escape "$model")\"}"
    ;;
  pull-cancel)
    if [ -z "$model" ]; then
      echo "model required" >&2
      exit 2
    fi
    safe_model="$(printf '%s' "$model" | tr '/:' '__')"
    log="/var/log/hpc-ollama/pull-${safe_model}.log"
    result_file="$PULL_STATE_DIR/pull-${safe_model}.result"
    active_model="$(cat "$PULL_MODEL_FILE" 2>/dev/null || true)"
    pid="$(cat "$PULL_PID_FILE" 2>/dev/null || true)"
    result="$(cat "$result_file" 2>/dev/null || true)"
    if [ -n "$active_model" ] && [ "$active_model" != "$model" ]; then
      echo "another model pull is running: $active_model" >&2
      exit 1
    fi
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      worker_command=""
      if [ -r "/proc/$pid/cmdline" ]; then
        worker_command="$(tr '\0' ' ' <"/proc/$pid/cmdline")"
      fi
      case "$worker_command" in
        *" _pull-worker $model"*) ;;
        *)
          echo "pull worker verification failed" >&2
          exit 1
          ;;
      esac
      kill -TERM -- "-$pid" 2>/dev/null || true
      for _attempt in $(seq 1 50); do
        if ! kill -0 -- "-$pid" 2>/dev/null; then
          break
        fi
        sleep 0.1
      done
      if kill -0 -- "-$pid" 2>/dev/null; then
        kill -KILL -- "-$pid" 2>/dev/null || true
        for _attempt in $(seq 1 20); do
          if ! kill -0 -- "-$pid" 2>/dev/null; then
            break
          fi
          sleep 0.1
        done
      fi
      if kill -0 -- "-$pid" 2>/dev/null; then
        echo "pull worker did not stop" >&2
        exit 1
      fi
    elif [ "$result" != "cancelled_cleanup_failed" ]; then
      if [ "$result" = "0" ]; then
        printf '{"status":"already_completed","model":"%s"}\n' "$(json_escape "$model")"
        exit 0
      fi
      echo "model pull is not running" >&2
      exit 1
    fi
    result="$(cat "$result_file" 2>/dev/null || true)"
    if [ "$result" = "0" ]; then
      rm -f "$PULL_PID_FILE" "$PULL_MODEL_FILE"
      rmdir "$PULL_LOCK_DIR" 2>/dev/null || true
      printf '{"status":"already_completed","model":"%s"}\n' "$(json_escape "$model")"
      exit 0
    fi
    sleep 1
    cleanup_ok=true
    if ! cleanup_partial_download "$log"; then
      cleanup_ok=false
    fi
    sleep 0.3
    if ! cleanup_partial_download "$log"; then
      cleanup_ok=false
    fi
    if [ "$cleanup_ok" = true ]; then
      printf 'cancelled' >"$result_file"
      rm -f "$PULL_PID_FILE" "$PULL_MODEL_FILE"
      rmdir "$PULL_LOCK_DIR" 2>/dev/null || true
      printf '{"status":"cancelled","model":"%s"}\n' "$(json_escape "$model")"
      exit 0
    fi
    printf 'cancelled_cleanup_failed' >"$result_file"
    rm -f "$PULL_PID_FILE" "$PULL_MODEL_FILE"
    rmdir "$PULL_LOCK_DIR" 2>/dev/null || true
    echo "ダウンロードは中止しましたが、途中データを削除できませんでした" >&2
    exit 1
    ;;
  pull-status)
    active=false
    active_model="$(cat "$PULL_MODEL_FILE" 2>/dev/null || true)"
    last_model="$(cat "$PULL_LAST_MODEL_FILE" 2>/dev/null || true)"
    if [ -f "$PULL_PID_FILE" ] && kill -0 "$(cat "$PULL_PID_FILE")" 2>/dev/null; then
      active=true
    fi
    status_model="${model:-${active_model:-$last_model}}"
    safe_model="$(printf '%s' "$status_model" | tr '/:' '__')"
    last=""
    result=""
    if [ -n "$status_model" ]; then
      last="$(tail -n 1 "/var/log/hpc-ollama/pull-${safe_model}.log" 2>/dev/null || true)"
      result="$(cat "$PULL_STATE_DIR/pull-${safe_model}.result" 2>/dev/null || true)"
    fi
    printf '{"active":%s,"active_model":"%s","model":"%s","result":"%s","last":"%s"}\n' \
      "$active" "$(json_escape "$active_model")" "$(json_escape "$status_model")" "$(json_escape "$result")" "$(json_escape "$last")"
    ;;
  delete)
    if [ -z "$model" ]; then
      echo "model required" >&2
      exit 2
    fi
    sudo -u "$SERVICE_USER" curl -fsS -X DELETE "$OLLAMA_URL/api/delete" \
      -H 'Content-Type: application/json' \
      -d "{\"name\":\"$model\"}"
    if [ "$(cat "$PULL_LAST_MODEL_FILE" 2>/dev/null || true)" = "$model" ]; then
      safe_model="$(printf '%s' "$model" | tr '/:' '__')"
      rm -f "$PULL_LAST_MODEL_FILE" "$PULL_STATE_DIR/pull-${safe_model}.result"
    fi
    ;;
  *)
    echo "usage: hpc-ollama start|stop|status|tags|ps|pull <model>|pull-cancel <model>|pull-status [model]|delete <model>" >&2
    exit 2
    ;;
esac
