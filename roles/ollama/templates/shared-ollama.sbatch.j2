#!/bin/bash
#SBATCH --job-name={{ ollama_slurm_job_name }}
#SBATCH --partition={{ ollama_slurm_partition }}
#SBATCH --cpus-per-task={{ ollama_slurm_cpus }}
#SBATCH --mem={{ ollama_slurm_memory }}
#SBATCH --gres=gpu:{{ ollama_slurm_gpus }}
#SBATCH --time={{ ollama_slurm_time }}
#SBATCH --output=/var/log/hpc-ollama/shared-ollama-%j.log

set -euo pipefail

export OLLAMA_HOST={{ ollama_host }}:{{ ollama_port }}
export OLLAMA_MODELS={{ ollama_models_dir }}
export HOME={{ ollama_service_home }}

exec /usr/local/bin/ollama serve
