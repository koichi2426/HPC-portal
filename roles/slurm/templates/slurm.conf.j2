ClusterName={{ slurm_cluster_name | default('hpc') }}
SlurmctldHost={{ ansible_hostname }}

SlurmUser=slurm
SlurmdUser=root
AuthType=auth/munge
StateSaveLocation=/var/spool/slurmctld
SlurmdSpoolDir=/var/spool/slurmd
SlurmctldPort={{ slurmctld_port | default(6817) }}
SlurmdPort={{ slurmd_port | default(6818) }}
SwitchType=switch/none
MpiDefault=none
ProctrackType=proctrack/cgroup
TaskPlugin=task/cgroup
ReturnToService=2
SchedulerType=sched/backfill
SelectType=select/cons_tres
SelectTypeParameters=CR_CPU_Memory

# 単一ノード簡易構成: アカウンティングDB連携を無効化
AccountingStorageType=accounting_storage/none

# エラーログの「Configured MailProg is invalid」を消すための設定
MailProg=/usr/bin/true

# 単一ノード構成: NodeNameは実際のホスト名と完全に一致させる必要があります
NodeName={{ ansible_hostname }} NodeAddr=127.0.0.1 CPUs={{ ansible_processor_vcpus | default(4) }} RealMemory={{ ansible_memtotal_mb | default(8192) }} State=UNKNOWN
PartitionName=debug Nodes={{ ansible_hostname }} Default=YES MaxTime=INFINITE State=UP