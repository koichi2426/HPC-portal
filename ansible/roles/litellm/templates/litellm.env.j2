LITELLM_MASTER_KEY={{ litellm_master_key }}
LITELLM_SALT_KEY={{ litellm_salt_key }}
UI_USERNAME={{ litellm_ui_username }}
UI_PASSWORD={{ litellm_ui_password }}
LITELLM_HIDE_DEFAULT_CREDENTIALS_HINT=True
DATABASE_URL=postgresql://{{ litellm_database_user }}:{{ litellm_database_password | urlencode }}@{{ litellm_database_host }}:{{ litellm_database_port }}/{{ litellm_database_name }}
STORE_MODEL_IN_DB=True
PROXY_BASE_URL={{ litellm_proxy_base_url }}
OLLAMA_API_BASE=http://{{ ollama_host }}:{{ ollama_port }}
