---
# Cloudflare Zero Trust dashboard で発行した token を設定
cloudflared_token: "REPLACE_WITH_YOUR_CLOUDFLARED_TOKEN"

# LiteLLM / PostgreSQL
litellm_master_key: "sk-REPLACE_WITH_LITELLM_MASTER_KEY"
litellm_salt_key: "REPLACE_WITH_RANDOM_SALT_KEY"
litellm_database_password: "REPLACE_WITH_LITELLM_DATABASE_PASSWORD"

# Open WebUI が LiteLLM に接続するための service key
openwebui_litellm_api_key: "sk-REPLACE_WITH_OPENWEBUI_KEY"
