---
# Cloudflare Zero Trust dashboard で発行した token を設定
cloudflared_token: "REPLACE_WITH_YOUR_CLOUDFLARED_TOKEN"

# LiteLLM / PostgreSQL
litellm_master_key: "sk-REPLACE_WITH_LITELLM_MASTER_KEY"
litellm_salt_key: "REPLACE_WITH_RANDOM_SALT_KEY"
litellm_database_password: "REPLACE_WITH_LITELLM_DATABASE_PASSWORD"
# LiteLLM UIへのログイン用
litellm_ui_username: "admin"
litellm_ui_password: "REPLACE_WITH_LITELLM_UI_PASSWORD"

# SearXNGのCookie・内部署名に使用するランダムな秘密値
searxng_secret_key: "REPLACE_WITH_RANDOM_SEARXNG_SECRET_KEY"

# LiteLLMからWeb検索MCPへの内部通信だけに使用するBearer token
search_mcp_auth_token: "REPLACE_WITH_RANDOM_SEARCH_MCP_AUTH_TOKEN"
