# Secrets
ansible/inventory/group_vars/all/secret.yml
ansible/inventory/group_vars/all/nfs_mounts.yml
ansible/inventory/group_vars/all/optional_features.yml
# 移行前の任意機能設定もGitへ追加しない。
ansible/inventory/group_vars/all/ssh_access.yml
ansible/inventory/group_vars/all/external_api.yml
ansible/inventory/*.ini
!ansible/inventory/production.ini.example

# 移行前の設定が残っていても、秘密情報をGitへ追加しない。
group_vars/all/secret.yml
group_vars/all/nfs_mounts.yml
inventory/*
!inventory/production.ini.example

# Ansible runtime artifacts
.ansible/
*.retry

# Local Python development environment
.venv/
.pytest_cache/
__pycache__/
*.py[cod]
.coverage
htmlcov/

# Local manuals (not published to GitHub)
/docs/

# ローカルのエージェント向け指示
/AGENTS.md
